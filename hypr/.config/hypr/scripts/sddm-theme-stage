#!/bin/bash
# Arma el tema del greeter de SDDM (Fase 9 B3) como el usuario, completo, en
# ~/.cache/matugen/sddm-login/. Despues /usr/local/bin/sync-sddm-theme (root,
# sin argumentos) solo lo copia a /usr/share/sddm/themes/dotfiles-login: root
# nunca lee el home ni decide que archivos van.
#
# Contenido (una sola implementacion, nada se copia a mano):
#   sddm/theme/        Main.qml, SddmAuth.qml, qmldir, theme.conf, metadata.desktop
#   dotshell           Tokens.qml, SemanticPalette.qml, I18nCore.qml, modules/Icon.qml,
#                      login/ (la pantalla de entrada compartida con el bloqueo)
#   scripts/i18n       I18n.qml: el idioma del usuario (appearance.language) con su
#                      catalogo, solo las claves del greeter (Fase 15 B3; el greeter
#                      no tiene el almacen ni lee el home)
#   matugen            Colors.qml (templates/sddm/Colors.qml, pasada del sistema)
#   el usuario         backgrounds/wall.png (el wallpaper actual), face.png (~/.face)
#                      y en theme.conf su tipografia y tamano del texto (Fase 10 B2;
#                      una fuente solo si esta instalada para todo el sistema: el
#                      greeter corre como "sddm" y no ve las del home)
# Archivos regulares solamente (cp -L): la copia root rechaza enlaces.
# Lo llama theme-apply.sh despues de la pasada del sistema de matugen.
# Pruebas: SDDM_STAGE (destino), SDDM_COLORS (paleta generada), DOTFILES.
set -euo pipefail

REPO=${DOTFILES:-$HOME/Dotfiles}
SHELL_DIR=$REPO/quickshell/.config/quickshell/dotshell
THEME_SRC=$REPO/sddm/theme
COLORS=${SDDM_COLORS:-$HOME/.cache/matugen/sddm-login-colors.qml}
OUT=${SDDM_STAGE:-$HOME/.cache/matugen/sddm-login}
WALLPAPER_CONF=$HOME/.config/hypr/current-wallpaper.conf

# matugen todavia no genero la paleta (primer arranque): nada que armar.
[ -f "$COLORS" ] || exit 0

mkdir -p "$(dirname "$OUT")"
tmp=$(mktemp -d "$OUT.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

cp -L "$THEME_SRC/Main.qml" "$THEME_SRC/SddmAuth.qml" "$THEME_SRC/qmldir" \
      "$THEME_SRC/theme.conf" "$THEME_SRC/metadata.desktop" "$tmp/"
cp -L "$SHELL_DIR/Tokens.qml" "$SHELL_DIR/SemanticPalette.qml" "$SHELL_DIR/I18nCore.qml" "$tmp/"
mkdir -p "$tmp/modules" "$tmp/login" "$tmp/backgrounds"
cp -L "$SHELL_DIR/modules/Icon.qml" "$tmp/modules/"
cp -L "$SHELL_DIR/login/"*.qml "$tmp/login/"
cp -L "$COLORS" "$tmp/Colors.qml"

# Idioma (Fase 15 B3): el nucleo con el catalogo ya puesto (ingles = sin catalogo).
I18N=${I18N_CMD:-$REPO/hypr/.config/hypr/scripts/i18n}
lang=$("$I18N" lang 2>/dev/null || echo en)
catalog=null
[ "$lang" = en ] || catalog=$("$I18N" bundle "$lang" "$tmp/I18nCore.qml" "$tmp/Main.qml" "$tmp/SddmAuth.qml" "$tmp/login/"*.qml 2>/dev/null || echo null)
[ -n "$catalog" ] || catalog=null
printf '// Generado por sddm-theme-stage (Fase 15 B3): idioma %s.\npragma Singleton\nimport QtQuick\n\nI18nCore {\n    lang: "%s"\n    catalog: (%s)\n}\n' \
  "$lang" "$lang" "$catalog" > "$tmp/I18n.qml"

# Tipografia y tamano del texto (Fase 10 B2), del almacen de opciones.
SETTINGS=${SETTINGS_CMD:-$REPO/hypr/.config/hypr/scripts/settings}
system_font() { # familia -> 0 si esta en /usr/share/fonts
  fc-list --format '%{file}\n' ":family=$1" 2>/dev/null | grep -q '^/usr/share/fonts/'
}
for pair in uiFont:appearance.font.ui monoFont:appearance.font.mono; do
  f=$("$SETTINGS" get "${pair#*:}" 2>/dev/null || true)
  if [ -n "$f" ] && system_font "$f"; then
    printf '%s=%s\n' "${pair%%:*}" "$f" >> "$tmp/theme.conf"
  elif [ -n "$f" ]; then
    echo "sddm-theme-stage: $f no esta instalada para todo el sistema; el greeter usa la de fabrica" >&2
  fi
done
for pair in uiScale:accessibility.uiScale textScale:accessibility.textScale; do
  s=$("$SETTINGS" get "${pair#*:}" 2>/dev/null || true)
  [ -n "$s" ] && printf '%s=%s\n' "${pair%%:*}" "$s" >> "$tmp/theme.conf"
done

# El greeter corre como el usuario "sddm": no puede leer el home (700).
wp=$(grep -oP '(?<=path = ).*' "$WALLPAPER_CONF" 2>/dev/null | head -1 | sed "s|^~|$HOME|" || true)
[ -n "$wp" ] && [ -f "$wp" ] && cp -L "$wp" "$tmp/backgrounds/wall.png"
[ -f "$HOME/.face" ] && cp -L "$HOME/.face" "$tmp/face.png"

chmod -R u=rwX,go=rX "$tmp"
rm -rf "$OUT"
mv "$tmp" "$OUT"
trap - EXIT
