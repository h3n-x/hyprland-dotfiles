#!/usr/bin/env python3
# Opciones del almacen que viven fuera de la shell (Fase 10 B3, P10.3, P10.9):
# Hyprland y hypridle. El esquema dice a que va cada clave ("hypr": opcion de
# Hyprland, "idle": parte de hypridle); el almacen es la unica fuente y esto
# genera, nunca edita a mano:
#   ~/.local/state/dotfiles/hypr-overrides.lua  solo las claves cambiadas
#       (hyprland.lua lo carga al final: la config versionada es la de fabrica)
#   ~/.local/state/dotfiles/hypridle.conf       la config entera de hypridle
#
#   settings-apply changed <clave>...    lo llama scripts/settings tras escribir:
#                                        rehace lo que toca y lo aplica ya
#   settings-apply hypr [--all|<clave>...]  rehace los overrides y los aplica en
#                                        vivo (hyprctl eval, sin recargar)
#   settings-apply idle [--restart]      rehace hypridle.conf; con --restart (o si
#                                        cambio) reinicia hypridle, salvo en modo juego
#   settings-apply render                los dos archivos, sin aplicar (autostart)
#   settings-apply live [--all|<clave>...]  JSON: valor esperado y el de Hyprland
#                                        (hyprctl getoption) por clave
#   settings-apply idle-suspend          accion de suspender de hypridle: respeta
#                                        "Suspender tambien enchufado"
#
# Pruebas: SETTINGS_SCHEMA, SETTINGS_EFFECTIVE (como scripts/settings),
# SETTINGS_APPLY_STATE (carpeta de salida), SETTINGS_APPLY_HYPRCTL (otro
# hyprctl), SETTINGS_APPLY_HYPRIDLE (otro arranque de hypridle; "" = no
# reiniciar), SETTINGS_APPLY_SUSPEND (otra accion de suspender),
# SETTINGS_APPLY_POWER (carpeta de power_supply), GAMEMODE_STATE.
import glob
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile

HOME = os.environ["HOME"]
SCHEMA = os.environ.get("SETTINGS_SCHEMA") or f"{HOME}/.config/quickshell/dotshell/data/settings.schema.json"
EFFECTIVE = os.environ.get("SETTINGS_EFFECTIVE") or f"{os.environ.get('XDG_CACHE_HOME') or HOME + '/.cache'}/dotfiles/settings.effective.json"
SETTINGS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "settings")
STATE = os.environ.get("SETTINGS_APPLY_STATE") or f"{HOME}/.local/state/dotfiles"
OVERRIDES = f"{STATE}/hypr-overrides.lua"
IDLE_CONF = f"{STATE}/hypridle.conf"
HYPRCTL = shlex.split(os.environ.get("SETTINGS_APPLY_HYPRCTL") or "hyprctl")
HYPRIDLE = os.environ.get("SETTINGS_APPLY_HYPRIDLE", f"hypridle -c {IDLE_CONF}")
SUSPEND = shlex.split(os.environ.get("SETTINGS_APPLY_SUSPEND") or "systemctl suspend")
POWER = os.environ.get("SETTINGS_APPLY_POWER") or "/sys/class/power_supply"
GAMEMODE = os.environ.get("GAMEMODE_STATE") or f"/tmp/gamemode-{os.environ.get('USER', '')}.state"


def load():
    s = json.load(open(SCHEMA))
    try:
        eff = json.load(open(EFFECTIVE))
    except (OSError, ValueError):
        # Sin cache todavia: el motor la arma (y si no puede, valen los de fabrica).
        subprocess.run([SETTINGS, "dump"], capture_output=True)
        try:
            eff = json.load(open(EFFECTIVE))
        except (OSError, ValueError):
            eff = {"values": {k: m["default"] for k, m in s["keys"].items()}, "modified": []}
    return s, eff


def write_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


# ---- Hyprland ---------------------------------------------------------------------------
def hypr_values(m, v):
    """{opcion de Hyprland: valor} para el valor v de una clave."""
    opt = m["hypr"]
    if m.get("kind") == "xkb":
        lay = [x.split(":", 1)[0] for x in v] or ["us"]
        var = [x.split(":", 1)[1] if ":" in x else "" for x in v] or [""]
        return {"input:kb_layout": ",".join(lay), "input:kb_variant": ",".join(var)}
    if m.get("hyprInvert"):
        v = not v
    if m.get("cast") == "int":
        v = int(v)
    return {opt: v}


def lua_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    return '"' + str(v).replace("\\", "\\\\").replace('"', '\\"') + '"'


def lua_config(opt, v):
    """hl.config({ a = { b = valor } }) para "a:b" (los guiones de getoption son _ en Lua)."""
    parts = opt.replace("-", "_").split(":")
    inner = f"{parts[-1]} = {lua_value(v)}"
    for p in reversed(parts[:-1]):
        inner = f"{p} = {{ {inner} }}"
    return f"hl.config({{ {inner} }})"


def hypr_keys(s, keys=None):
    return [k for k, m in s["keys"].items() if m.get("hypr") and (keys is None or k in keys)]


def render_overrides(s, eff):
    lines = ["-- Generado por scripts/settings-apply (Fase 10 B3) desde ~/.config/dotfiles/settings.json:",
             "-- solo las opciones cambiadas en el centro de configuracion. No editar a mano.", ""]
    for k in hypr_keys(s):
        if k in eff.get("modified", []):
            lines.append(f"-- {k}")
            for opt, v in hypr_values(s["keys"][k], eff["values"][k]).items():
                lines.append(lua_config(opt, v))
    text = "\n".join(lines) + "\n"
    # Lua valido antes de reemplazar el que carga Hyprland.
    fd, tmp = tempfile.mkstemp(suffix=".lua")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    r = subprocess.run(["luac", "-p", tmp], capture_output=True, text=True)
    os.unlink(tmp)
    if r.returncode != 0:
        sys.exit(f"settings-apply: Lua generado no valido, no se escribe: {r.stderr.strip()}")
    write_atomic(OVERRIDES, text)


def apply_hypr(s, eff, keys):
    """Aplica en vivo los valores actuales (o de fabrica) de keys: un solo eval."""
    code = []
    for k in hypr_keys(s, keys):
        for opt, v in hypr_values(s["keys"][k], eff["values"][k]).items():
            code.append(lua_config(opt, v))
    if not code:
        return
    r = subprocess.run(HYPRCTL + ["eval", "\n".join(code)], capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip()
    if r.returncode != 0 or (out and out != "ok"):
        print(f"settings-apply: hyprctl eval: {out}", file=sys.stderr)


def live(s, eff, keys):
    """Por clave: lo que el almacen pide y lo que Hyprland usa (getoption)."""
    out = {}
    for k in hypr_keys(s, keys):
        for opt, want in hypr_values(s["keys"][k], eff["values"][k]).items():
            r = subprocess.run(HYPRCTL + ["getoption", "-j", opt], capture_output=True, text=True)
            try:
                j = json.loads(r.stdout)
                got = next(v for kk, v in j.items() if kk not in ("option", "set"))
            except (ValueError, StopIteration):
                continue
            # gaps: "4 4 4 4" (css) = 4
            if isinstance(got, str) and isinstance(want, (int, float)) and not isinstance(want, bool):
                p = got.split()
                got = float(p[0]) if p and all(x == p[0] for x in p) else got
            same = (abs(got - want) < 1e-6) if isinstance(got, (int, float)) and isinstance(want, (int, float)) and not isinstance(want, bool) else got == want
            out.setdefault(k, {"same": True, "live": []})
            out[k]["live"].append(got)
            out[k]["same"] = out[k]["same"] and same
    return out


# ---- hypridle ---------------------------------------------------------------------------
GENERAL = """general {
    # Bloqueo de Quickshell vigilado (Fase 9 B1). Sin --user: un evento de
    # inactividad con la sesion ya bloqueada no hace nada (flock).
    lock_cmd = ~/.config/hypr/scripts/lock
    before_sleep_cmd = loginctl lock-session
    # --resume: Hyprland no le devuelve el teclado a la superficie de bloqueo
    # que ya existia; el bloqueo se recrea (no cuenta como caida).
    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })'; ~/.config/hypr/scripts/lock --resume
    # 3 = esperar a que la sesion este bloqueada antes de suspender
    # (2 = automatico, solo reconoce hyprlock en lock_cmd).
    inhibit_sleep = 3
}
"""


def render_idle(s, eff):
    v = eff["values"]
    sec = lambda minutes: int(round(float(minutes) * 60))
    blocks = ["# Generado por scripts/settings-apply (Fase 10 B3) desde las opciones de Energia del centro de",
              "# configuracion. No editar a mano: se rehace en cada cambio.", "", GENERAL]
    if v.get("power.dim") and v.get("power.dimAfter", 0) > 0:
        blocks.append(f"listener {{\n    timeout = {sec(v['power.dimAfter'])}\n    on-timeout = brightnessctl -s set 10\n    on-resume = brightnessctl -r\n}}\n")
    if v.get("power.lockAfter", 0) > 0:
        blocks.append(f"listener {{\n    timeout = {sec(v['power.lockAfter'])}\n    on-timeout = loginctl lock-session\n}}\n")
    if v.get("power.screenOffAfter", 0) > 0:
        blocks.append(f"listener {{\n    timeout = {sec(v['power.screenOffAfter'])}\n"
                      "    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = \"disable\" })'\n"
                      "    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = \"enable\" })' && brightnessctl -r\n}\n")
    if v.get("power.suspendAfter", 0) > 0:
        blocks.append(f"listener {{\n    timeout = {sec(v['power.suspendAfter'])}\n"
                      "    on-timeout = ~/.config/hypr/scripts/settings-apply idle-suspend\n}\n")
    text = "\n".join(blocks)
    old = open(IDLE_CONF).read() if os.path.exists(IDLE_CONF) else None
    if text != old:
        write_atomic(IDLE_CONF, text)
    return text != old


def restart_idle():
    if not HYPRIDLE:
        return
    if os.path.exists(GAMEMODE):
        return  # pausado por el modo juego: al salir lo reinicia con la config nueva
    # Uno detenido por el modo juego (SIGSTOP) no atiende la senal de salida
    # hasta seguir: primero CONT.
    subprocess.run(["pkill", "-CONT", "-x", "hypridle"], capture_output=True)
    subprocess.run(["pkill", "-x", "hypridle"], capture_output=True)
    subprocess.Popen(["setsid", "-f"] + shlex.split(HYPRIDLE), stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def on_ac():
    for f in glob.glob(f"{POWER}/*/online"):
        try:
            if open(f).read().strip() == "1":
                return True
        except OSError:
            pass
    return False


# ---- CLI --------------------------------------------------------------------------------
args = sys.argv[1:]
cmd = args[0] if args else ""
s, eff = load()
if cmd == "changed":
    keys = set(args[1:])
    hk = [k for k in keys if s["keys"].get(k, {}).get("hypr")]
    if hk:
        render_overrides(s, eff)
        apply_hypr(s, eff, hk)
    if any(s["keys"].get(k, {}).get("idle") for k in keys):
        if render_idle(s, eff):
            restart_idle()
elif cmd == "hypr":
    render_overrides(s, eff)
    apply_hypr(s, eff, None if args[1:] in ([], ["--all"]) else set(args[1:]))
elif cmd == "idle":
    if render_idle(s, eff) or "--restart" in args:
        restart_idle()
elif cmd == "render":
    render_overrides(s, eff)
    render_idle(s, eff)
elif cmd == "live":
    print(json.dumps(live(s, eff, None if args[1:] in ([], ["--all"]) else set(args[1:])), ensure_ascii=False))
elif cmd == "idle-suspend":
    if eff["values"].get("power.suspendOnAC", True) or not on_ac():
        sys.exit(subprocess.run(SUSPEND).returncode)
else:
    sys.exit("uso: settings-apply changed <clave>...|hypr [--all|<clave>...]|idle [--restart]|render|live [--all|<clave>...]|idle-suspend")
