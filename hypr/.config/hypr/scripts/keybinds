#!/usr/bin/env python3
"""Atajos de Hyprland para la guia de atajos (Fase 4 B10), leidos de Hyprland.

    keybinds data       JSON agrupado para Quickshell (KeybindState), en ingles
    keybinds markdown [--lang L]   la tabla de atajos del README (misma agrupacion), por stdout
    keybinds readme     reescribe esa tabla en el README, solo entre los marcadores
    keybinds readme --check   0 al dia, 1 desactualizada (dice que filas), 2 no se puede verificar
    keybinds check      falla (exit 1) si un atajo no tiene descripcion valida

La unica fuente es `hyprctl binds -j` (la configuracion viva, submaps
incluidos): la descripcion sale del { desc = "Grupo · Texto" } de cada
hl.bind en binds.lua. Nunca se lee binds.lua. Los atajos de una familia
(misma descripcion) se juntan en una fila: flechas, 1-0, volumen, rueda.
KEYBINDS_JSON=<archivo> usa ese JSON en vez de hyprctl (pruebas).

Idioma (Fase 15 B3): las descripciones de binds.lua, los grupos y los nombres de
las teclas estan en ingles, que es la clave del catalogo (dotshell/data/i18n).
"data" los entrega tal cual y la shell los traduce (cambia de idioma en vivo);
"markdown" y "readme" los traducen aqui, con el catalogo de scripts/i18n.

La tabla del README (Fase 8 B7, P8.5) solo la escribe `keybinds readme`:
reemplaza lo que hay entre <!-- keybinds:start ... --> y <!-- keybinds:end -->
y nada mas (el resto del README queda igual byte a byte); si ya esta al dia
no escribe. No corre solo: lo verifica el drift check de la documentacion. El
tabla va en los dos README (Fase 15 B4): README.md en ingles y README.es.md en espanol.
KEYBINDS_README=<archivo> usa ese README (pruebas).
"""
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))


def N_(ctx, text):
    """Marca un texto para i18n extract; se traduce al mostrarlo."""
    return text


def i18n():
    sys.dont_write_bytecode = True  # sin __pycache__ junto a los scripts
    loader = importlib.machinery.SourceFileLoader("i18n", os.path.join(HERE, "i18n"))
    spec = importlib.util.spec_from_loader("i18n", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


# Mensajes de la linea de comandos en el idioma del usuario (Fase 15 B4).
T, Tn = i18n().translator()

SEP = " · "
MAX_TEXT = 28
UNDESCRIBED = N_("keybind group", "No description")

# Orden e icono (Material Symbols) de los grupos de binds.lua; "mode": atajos de un submap.
GROUPS = [
    ("Shell", "dashboard"), ("Apps", "apps"), ("System", "power_settings_new"),
    ("Windows", "select_window"), ("Workspaces", "view_quilt"), ("Capture", "screenshot_region"),
    ("Theme", "palette"), ("Media", "music_note"), ("Resize mode", "open_in_full"),
]
MODS = [(64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, "Shift")]

# Etiqueta de cada tecla: texto, o "@icono" (Material Symbols); "words" para Markdown.
# Los nombres con N_ se traducen (contexto "key"); el resto es igual en todos los idiomas.
KEYS = {
    "return": N_("key", "Enter"), "escape": "Esc", "tab": "Tab", "period": ".", "slash": "/", "comma": ",",
    "print": N_("key", "Print"), "space": N_("key", "Space"), "backspace": N_("key", "Backspace"),
    "delete": N_("key", "Delete"), "caps_lock": N_("key", "Caps Lock"), "num_lock": N_("key", "Num Lock"),
    "super_l": "Super",
    "mouse:272": N_("key", "Left click"), "mouse:273": N_("key", "Right click"),
    "control_l": N_("key", "Left Ctrl"), "alt_l": N_("key", "Left Alt"),
    "left": "@arrow_left", "right": "@arrow_right", "up": "@arrow_drop_up", "down": "@arrow_drop_down",
    "xf86audioraisevolume": "@volume_up", "xf86audiolowervolume": "@volume_down",
    "xf86audiomute": "@volume_off", "xf86audiomicmute": "@mic_off",
    "xf86monbrightnessup": "@brightness_high", "xf86monbrightnessdown": "@brightness_low",
    "xf86audioplay": "@play_pause", "xf86audiopause": "@play_pause",
    "xf86audionext": "@skip_next", "xf86audioprev": "@skip_previous",
}
# Iconos en palabras (los mismos textos que KeybindState.iconWords).
WORDS = {
    "@arrows": N_("key", "Arrows"), "@arrow_left": "←", "@arrow_right": "→", "@arrow_drop_up": "↑", "@arrow_drop_down": "↓",
    "@volume_up": N_("key", "Volume up"), "@volume_down": N_("key", "Volume down"), "@volume_off": N_("key", "Mute"),
    "@mic_off": N_("key", "Microphone"), "@brightness_high": N_("key", "Brightness up"),
    "@brightness_low": N_("key", "Brightness down"), "@play_pause": N_("key", "Play/Pause"),
    "@skip_next": N_("key", "Next"), "@skip_previous": N_("key", "Previous"),
}
# Orden de lectura dentro de una familia (anterior antes que siguiente, subir antes que bajar).
ORDER = ["@arrow_left", "@arrow_right", "@arrow_drop_up", "@arrow_drop_down", "@volume_up", "@volume_down",
         "@brightness_high", "@brightness_low", "@skip_previous", "@skip_next"]


def load():
    path = os.environ.get("KEYBINDS_JSON")
    if path:
        with open(path) as f:
            return json.load(f)
    out = subprocess.run(["hyprctl", "binds", "-j"], capture_output=True, text=True, check=True).stdout
    return json.loads(out)


def mods_of(mask):
    return [name for bit, name in MODS if mask & bit]


def label(key):
    k = key.lower()
    if k in KEYS:
        return KEYS[k]
    return key.upper() if len(key) == 1 else key


def family_keys(keys):
    """Teclas de una familia (mismos modificadores) -> etiquetas, ya juntas."""
    low = {k.lower() for k in keys}
    if low == {"left", "right", "up", "down"}:
        return ["@arrows"]
    if low == {str(d) for d in range(10)}:
        return ["1 … 0"]
    if low == {"mouse_down", "mouse_up"}:
        return [N_("key", "Wheel")]
    labels = []
    for k in keys:
        lab = label(k)
        if lab not in labels:
            labels.append(lab)
    return sorted(labels, key=lambda x: ORDER.index(x) if x in ORDER else -1)


def split_desc(desc):
    if SEP in desc:
        group, text = desc.split(SEP, 1)
        return group.strip(), text.strip()
    return None, desc.strip()


def problems(binds):
    """Atajos sin descripcion valida: sin desc, sin grupo o texto demasiado largo."""
    out = []
    for b in binds:
        desc = b.get("description", "") if b.get("has_description") else ""
        combo = " + ".join(mods_of(b["modmask"]) + [b["key"]]) + (f" (submap {b['submap']})" if b.get("submap") else "")
        group, text = split_desc(desc)
        if not desc:
            out.append(T("%1: no description", combo))
        elif not group:
            out.append(T("%1: the group is missing (%2): %3", combo, f'"Group{SEP}Text"', repr(desc)))
        elif len(text) > MAX_TEXT:
            out.append(T("%1: text of %2 characters (at most %3): %4", combo, len(text), MAX_TEXT, repr(text)))
    return out


def grouped(binds):
    items = {}   # (grupo, texto, submap) -> {mods: [teclas]} en orden de aparicion
    order = []
    for b in binds:
        desc = b.get("description", "") if b.get("has_description") else ""
        group, text = split_desc(desc)
        if not desc:
            group, text = UNDESCRIBED, " + ".join(mods_of(b["modmask"]) + [label(b["key"])])
        elif not group:
            group = UNDESCRIBED
        key = (group, text, b.get("submap", ""))
        if key not in items:
            items[key] = {}
            order.append(key)
        items[key].setdefault(tuple(mods_of(b["modmask"])), []).append(b["key"])
    known = [g for g, _ in GROUPS]
    groups = []
    for name in known + sorted({k[0] for k in order if k[0] not in known and k[0] != UNDESCRIBED}) + [UNDESCRIBED]:
        rows = [k for k in order if k[0] == name]
        if not rows:
            continue
        icon = dict(GROUPS).get(name, "help" if name == UNDESCRIBED else "keyboard")
        groups.append({
            "name": name, "icon": icon, "mode": any(k[2] for k in rows),
            "items": [{"text": k[1], "submap": k[2],
                       "combos": [{"mods": list(m), "keys": family_keys(keys)} for m, keys in items[k].items()]}
                      for k in rows],
        })
    return groups


def markdown(groups, lang):
    mod = i18n()
    cat = mod.load(lang)
    t = lambda text, ctx=None: mod.lookup(cat, text, ctx)
    key = lambda lab: f"`{t(WORDS.get(lab, lab), 'key')}`"
    mode = t(N_("keybinds readme", " (mode: %1, leave with %2)"), "keybinds readme")
    head = "| " + t(N_("keybinds readme", "Shortcut"), "keybinds readme") + " | " + t(N_("keybinds readme", "Action"), "keybinds readme") + " |"
    lines = []
    for g in groups:
        lines += [f"**{t(g['name'], 'keybind group')}**" + (mode.replace("%1", "`Super` + `R`").replace("%2", f"`Esc`/{key('Enter')}") if g["mode"] else ""), "",
                  head, "|---|---|"]
        for it in g["items"]:
            combos = f" {t('or')} ".join(" + ".join([key(m) for m in c["mods"]] + [" / ".join(key(k) for k in c["keys"])])
                                         for c in it["combos"])
            lines.append(f"| {combos} | {t(it['text'], 'keybind')} |")
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


# El README del repo de este script (enlazado por stow), en cualquier carpeta (Fase 19 B3).
README = os.environ.get("KEYBINDS_README") or os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "..", "..", "README.md"))
# Cada README con su idioma: el principal en ingles y su copia en espanol al lado.
READMES = [(README, "en"), (os.path.join(os.path.dirname(README), "README.es.md"), "es")]
START = "<!-- keybinds:start"
END = "<!-- keybinds:end -->"


def readme(check):
    """Las tablas de los README: 0 al dia (o reescritas), 1 desactualizada (--check), 2 no se puede verificar."""
    try:
        groups = grouped(load())
    except (OSError, ValueError, subprocess.CalledProcessError) as e:
        print(T("can't verify: no Hyprland shortcuts (%1)", e.__class__.__name__), file=sys.stderr)
        return 2
    return max(readme_one(path, lang, markdown(groups, lang), check) for path, lang in READMES)


def readme_one(path, lang, new, check):
    path = os.path.realpath(path)
    name = os.path.basename(path)
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines(keepends=True)
    except OSError as e:
        print(T("can't verify: %1", e), file=sys.stderr)
        return 2
    starts = [i for i, l in enumerate(lines) if l.startswith(START)]
    ends = [i for i, l in enumerate(lines) if l.strip() == END]
    if len(starts) != 1 or len(ends) != 1 or ends[0] < starts[0]:
        print(T("can't verify: markers %1 ... %2 missing or repeated in %3", START, END, path), file=sys.stderr)
        return 2
    s, e = starts[0], ends[0]
    old = "".join(lines[s + 1:e])
    if old == new:
        print(f"{name}: " + T("README shortcut table up to date"))
        return 0
    if check:
        was, now = old.splitlines(), new.splitlines()
        for row in was:
            if row and row not in now:
                print(f"  - {row}")
        for row in now:
            if row and row not in was:
                print(f"  + {row}")
        print(f"{name}: " + T("README shortcut table out of date: %1", "hypr/.config/hypr/scripts/keybinds readme"))
        return 1
    tmp = path + ".keybinds-tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("".join(lines[:s + 1]) + new + "".join(lines[e:]))
    os.chmod(tmp, os.stat(path).st_mode & 0o7777)
    os.replace(tmp, path)
    print(f"{name}: " + Tn("README shortcut table updated (%n row)", "README shortcut table updated (%n rows)", sum(1 for r in new.splitlines() if r.startswith('| ')) - new.count('|---|---|')))
    return 0


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "readme":
        sys.exit(readme("--check" in sys.argv[2:]))
    binds = load()
    if mode == "data":
        groups = grouped(binds)
        json.dump({"total": len(binds), "rows": sum(len(g["items"]) for g in groups),
                   "problems": problems(binds), "groups": groups}, sys.stdout, ensure_ascii=False)
        print()
    elif mode == "markdown":
        a = sys.argv[2:]
        lang = a[a.index("--lang") + 1] if "--lang" in a[:-1] else i18n().language()
        sys.stdout.write(markdown(grouped(binds), lang))
    elif mode == "check":
        bad = problems(binds)
        for p in bad:
            print(p, file=sys.stderr)
        print(T("%1 shortcuts, %2 without a valid description", len(binds), len(bad)))
        sys.exit(1 if bad else 0)
    else:
        print(T("usage: %1", "keybinds data|markdown [--lang L]|readme [--check]|check"), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
