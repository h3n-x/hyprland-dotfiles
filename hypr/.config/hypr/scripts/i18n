#!/usr/bin/env python3
# Traducciones (Fase 15 B1). Los catalogos son dotshell/data/i18n/<idioma>.json,
# con el texto fuente en ingles como clave (ver I18nCore.qml). El idioma es
# appearance.language del almacen ("auto" = LANGUAGE / LC_ALL / LC_MESSAGES / LANG
# de la sesion; ingles si no hay catalogo).
#
#   i18n tr [--ctx C] TEXTO [ARG...]   la traduccion (%1.. con ARG), para los scripts
#   i18n trn SINGULAR PLURAL N [ARG...] con plural (%n = N)
#   i18n lang                          el idioma efectivo
#   i18n extract [--json]              las claves que usa el codigo (QML, esquema)
#   i18n check [--quiet]               catalogos completos, sin claves viejas, mismos
#                                      %1..%9 y %n, plurales de su familia, y ningun texto
#                                      visible fuera de I18n en los archivos ya convertidos
#                                      (data/i18n.rules.json); salida 0/1
#   i18n stats                         cobertura por idioma
#   i18n bundle IDIOMA ARCHIVO...      el catalogo con solo las claves que usan esos QML
#                                      (el greeter de SDDM, que no tiene el almacen; B3)
#
# Los scripts en python lo importan (lookup()); marcan sus textos con N_(contexto,
# texto), dos cadenas literales, para que extract los vea. Tambien se extraen las descripciones de binds.lua
# ("Group · Text", contextos "keybind group" y "keybind"; Fase 15 B3).
#
# Pruebas: I18N_DIR (catalogos), I18N_QML (carpeta dotshell), I18N_LANG (idioma
# sin consultar el almacen), SETTINGS (otro motor de opciones), I18N_BINDS (binds.lua),
# I18N_SCRIPTS (carpeta de los scripts), I18N_SDDM (el tema del greeter, sddm/theme), I18N_INSTALL
# (el instalador del repo, install/).
# Los scripts de shell traducen con `i18n tr [--ctx C] "texto"`: extract los lee igual.
import json, os, re, subprocess, sys

HERE = os.path.dirname(os.path.realpath(__file__))
QML = os.environ.get("I18N_QML") or os.path.expanduser("~/.config/quickshell/dotshell")
CATS = os.environ.get("I18N_DIR") or os.path.join(QML, "data", "i18n")
RULES = os.path.join(QML, "data", "i18n.rules.json")
BINDS = os.environ.get("I18N_BINDS") or os.path.join(os.path.dirname(HERE), "modules", "binds.lua")
SCRIPTS = os.environ.get("I18N_SCRIPTS") or HERE
# El instalador del repo (Fase 19): install/*.sh y sus lib/ steps/ system/.
INSTALL = os.environ.get("I18N_INSTALL") or os.path.normpath(os.path.join(HERE, "..", "..", "..", "..", "install"))
SDDM = os.environ.get("I18N_SDDM") or os.path.normpath(os.path.join(HERE, "..", "..", "..", "..", "sddm", "theme"))
SEP = "\u0004"


def die(msg, code=2):
    print(f"i18n: {msg}", file=sys.stderr)
    sys.exit(code)


def available():
    try:
        return sorted(f[:-5] for f in os.listdir(CATS) if f.endswith(".json"))
    except OSError:
        return []


def language(setting=None):
    """El idioma efectivo. setting: el valor de appearance.language si quien llama ya lo
    tiene (el motor de opciones, que no puede consultarse a si mismo); si no, se pregunta."""
    if os.environ.get("I18N_LANG"):
        return os.environ["I18N_LANG"]
    if setting is not None:
        v = setting
    else:
        settings = os.environ.get("SETTINGS") or os.path.join(HERE, "settings")
        try:
            v = subprocess.run([settings, "get", "appearance.language"], capture_output=True, text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            v = ""
    langs = available()
    if v and v != "auto":
        return v if v in langs or v == "en" else "en"
    wanted = (os.environ.get("LANGUAGE") or "").split(":") + [os.environ.get(k, "") for k in ("LC_ALL", "LC_MESSAGES", "LANG")]
    for w in wanted:
        code = w.replace("-", "_").split("_")[0].split(".")[0].lower()
        if code == "en":
            return "en"
        if code in langs:
            return code
    return "en"


def load(lang):
    if lang == "en":
        return {}
    try:
        return json.load(open(os.path.join(CATS, lang + ".json")))
    except (OSError, ValueError):
        return {}


def category(family, n):
    a = abs(n)
    if family == "other":
        return "other"
    if family == "french":
        return "one" if a < 2 else "other"
    if family == "slavic":
        if a % 1:
            return "other"
        m10, m100 = a % 10, a % 100
        if m10 == 1 and m100 != 11:
            return "one"
        if 2 <= m10 <= 4 and not 12 <= m100 <= 14:
            return "few"
        return "many"
    return "one" if a == 1 else "other"


def fill(s, args):
    """%1..%9 en una sola pasada (un argumento que trae "%2" no se vuelve a reemplazar)."""
    return re.sub(r"%([1-9])", lambda m: args[int(m.group(1)) - 1] if int(m.group(1)) <= len(args) else m.group(0), s)


def lookup(cat, text, ctx=None):
    """La traduccion de text en un catalogo ya cargado (load()); el texto fuente si falta."""
    v = cat.get((ctx + SEP + text) if ctx else text)
    return v if isinstance(v, str) and v else text


def translator(setting=None):
    """Para los scripts en python: T(texto, *args, ctx=None) y Tn(singular, plural, n, *args).
    El catalogo se carga una sola vez, al primer uso (los caminos sin mensajes no pagan nada)."""
    state = {}

    def cat():
        if "cat" not in state:
            # setting puede ser una funcion (se lee recien al primer mensaje).
            lang = language(setting() if callable(setting) else setting)
            state["cat"] = load(lang)
        return state["cat"]

    def T(text, *args, ctx=None):
        return fill(lookup(cat(), text, ctx), [str(a) for a in args])

    def Tn(sing, plural, n, *args):
        c = cat()
        v = c.get(sing)
        fam = (c.get("@meta") or {}).get("plural", "one-other")
        if isinstance(v, dict):
            s = v.get(category(fam, n)) or v.get("other") or plural
        else:
            s = sing if abs(n) == 1 else plural
        num = str(int(n)) if n == int(n) else str(n)
        return fill(s.replace("%n", num), [str(a) for a in args])
    return T, Tn


# ---- Extraccion ---------------------------------------------------------------------------
STR = r'"((?:[^"\\]|\\.)*)"'
CALLS = [
    (re.compile(r"\bI18n\.tr\(\s*" + STR), lambda m: m.group(1)),
    (re.compile(r"\bI18n\.trc\(\s*" + STR + r"\s*,\s*" + STR), lambda m: m.group(1) + SEP + m.group(2)),
    (re.compile(r"\bI18n\.trn\(\s*" + STR + r"\s*,\s*" + STR), lambda m: m.group(1)),
    (re.compile(r"\bI18n\.date\([^,]+,\s*" + STR), lambda m: "format" + SEP + m.group(1)),
]
BIND_DESC = re.compile(r'desc\s*=\s*"([^"·]+) · ([^"]+)"')
SCRIPT_MARK = re.compile(r"\bN_\(\s*" + STR + r"\s*,\s*" + STR + r"\s*\)")
# En los scripts de shell: i18n tr [--ctx "C"] "texto" (tambien "$I18N" tr ...).
# Tambien la funcion corta i18n_tr que definen algunos scripts (i18n_tr "texto" args...).
SHELL_TR = re.compile(r'(?:(?i:i18n)"?\s+tr|\bi18n_tr)\s+(?:--ctx\s+"?([\w ]+?)"?\s+)?' + STR)
SHELL_TRN = re.compile(r'(?:(?i:i18n)"?\s+trn|\bi18n_trn)\s+' + STR)
# En el instalador (Fase 19): info/ok/warn/err/problem/note/tr_ "texto" args...
INSTALL_MSG = re.compile(r'(?<![\w-])(?:info|ok|warn|err|problem|note|tr_)\s+' + STR)
# En los scripts en python: T("texto", args..., ctx="c") y Tn("singular", "plural", n, ...).
PY_T = re.compile(r"\bT\(\s*" + STR)
PY_CTX = re.compile(r'\bctx\s*=\s*' + STR)
PY_TN = re.compile(r"\bTn\(\s*" + STR)
TRC_CTX = re.compile(r"\bI18n\.trc\(\s*" + STR + r"\s*,")
PLURAL_SRC = re.compile(r"\bI18n\.trn\(\s*" + STR + r"\s*,\s*" + STR)


def core_calls(path, text):
    """El nucleo (I18nCore.qml) se llama a si mismo como root.tr(...): es lo mismo que I18n.tr."""
    return re.sub(r"\broot\.(tr|trc|trn|date)\(", r"I18n.\1(", text) if os.path.basename(path) == "I18nCore.qml" else text


def call_rest(text, i):
    """Lo que queda de una llamada hasta su parentesis de cierre (puede ocupar varias lineas)."""
    depth, quote, j = 1, None, i
    while j < len(text) and depth:
        ch = text[j]
        if quote:
            if ch == "\\":
                j += 1
            elif ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
        elif ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        j += 1
    return text[i:j]


def unescape(s):
    return s.encode().decode("unicode_escape").encode("latin-1").decode("utf-8") if "\\" in s else s


def qml_files():
    out = []
    for d, _, fs in os.walk(QML):
        out += [os.path.join(d, f) for f in fs if f.endswith(".qml")]
    return sorted(out)


def sddm_files():
    """El greeter de SDDM (sddm/theme): sus QML propios, todos convertidos."""
    try:
        return sorted(os.path.join(SDDM, f) for f in os.listdir(SDDM) if f.endswith(".qml"))
    except OSError:
        return []


def qml_keys(files):
    """Claves que usan unos QML: {clave: (archivo:linea, plural)}."""
    out = {}
    for f in files:
        text = core_calls(f, open(f, errors="replace").read())
        rel = os.path.relpath(f, QML) if f.startswith(QML) else "sddm/" + os.path.basename(f)
        for rx, key in CALLS:
            for m in rx.finditer(text):
                out.setdefault(unescape(key(m)), (f"{rel}:{text.count(chr(10), 0, m.start()) + 1}", rx is CALLS[2][0]))
    return out


def extract():
    keys = {}   # clave -> {"where": [...], "plural": bool}
    def add(k, where, plural=False):
        e = keys.setdefault(k, {"where": [], "plural": plural})
        e["where"].append(where)
        e["plural"] = e["plural"] or plural
    for f in qml_files() + sddm_files():
        text = core_calls(f, open(f, errors="replace").read())
        rel = os.path.relpath(f, QML) if f.startswith(QML) else "sddm/" + os.path.basename(f)
        for rx, key in CALLS:
            for m in rx.finditer(text):
                add(unescape(key(m)), f"{rel}:{text.count(chr(10), 0, m.start()) + 1}", rx is CALLS[2][0])
    # Descripciones de los atajos (binds.lua, sin comentarios): grupo y texto.
    try:
        for n, line in enumerate(open(BINDS, encoding="utf-8"), 1):
            if line.lstrip().startswith("--"):
                continue
            for m in BIND_DESC.finditer(line):
                add("keybind group" + SEP + m.group(1).strip(), f"binds.lua:{n}")
                add("keybind" + SEP + m.group(2).strip(), f"binds.lua:{n}")
    except OSError:
        pass
    # Textos de los scripts en python marcados con N_(contexto, texto).
    for f in sorted(os.listdir(SCRIPTS)) if os.path.isdir(SCRIPTS) else []:
        p = os.path.join(SCRIPTS, f)
        try:
            text = open(p, encoding="utf-8").read()
        except (OSError, UnicodeDecodeError):
            continue
        line = lambda m: f"scripts/{f}:{text.count(chr(10), 0, m.start()) + 1}"
        if not text.startswith("#!"):
            continue
        # Las lineas de comentario no cuentan (se borra su texto, se conservan las lineas).
        text = re.sub(r"(?m)^[ \t]*#.*$", "", text)
        # Los python marcan con N_/T/Tn (tambien el motor de opciones, python dentro de bash).
        for m in SCRIPT_MARK.finditer(text):
            add(unescape(m.group(1)) + SEP + unescape(m.group(2)), line(m))
        for m in PY_T.finditer(text):
            c = PY_CTX.search(call_rest(text, m.end()))
            add((unescape(c.group(1)) + SEP if c else "") + unescape(m.group(1)), line(m))
        for m in PY_TN.finditer(text):
            add(unescape(m.group(1)), line(m), True)
        if not text.startswith("#!/usr/bin/env python3"):
            for m in SHELL_TR.finditer(text):
                if not m.group(2).startswith("$"):        # la definicion de i18n_tr ("$@")
                    add((m.group(1) + SEP if m.group(1) else "") + unescape(m.group(2)), line(m))
            for m in SHELL_TRN.finditer(text):
                add(unescape(m.group(1)), line(m), True)
    # El instalador (Fase 19): los mensajes de info/ok/warn/err/problem/note/tr_.
    for dp, _dn, fn in sorted(os.walk(INSTALL)) if os.path.isdir(INSTALL) else []:
        for f in sorted(fn):
            if not f.endswith(".sh"):
                continue
            p = os.path.join(dp, f)
            try:
                text = open(p, encoding="utf-8").read()
            except (OSError, UnicodeDecodeError):
                continue
            rel = os.path.relpath(p, os.path.dirname(INSTALL))
            text = re.sub(r"(?m)^[ \t]*#.*$", "", text)
            for m in INSTALL_MSG.finditer(text):
                if not m.group(1).startswith("$"):
                    add(unescape(m.group(1)), f"{rel}:{text.count(chr(10), 0, m.start()) + 1}")

    # El esquema de opciones (en ingles, Fase 15 B3): todo lo que muestra el centro de
    # configuracion va con el contexto "settings" (SettingsModel.localized); las palabras
    # clave de cada opcion, juntas, con "settings keywords"; los nombres de los ajustes
    # rapidos y de las zonas de Inicio con "tile" y "zone" (los usa la shell).
    try:
        sch = json.load(open(os.path.join(QML, "data", "settings.schema.json")))
    except (OSError, ValueError):
        sch = {}
    def shown(v, where):
        if isinstance(v, str) and re.search(r"[^\W\d_]", v):
            add("settings" + SEP + v, where)
    for cid, c in (sch.get("categories") or {}).items():
        shown(c.get("label"), "settings.schema.json:categories." + cid)
    for key, m in (sch.get("keys") or {}).items():
        where = "settings.schema.json:" + key
        for f in ("section", "label", "description", "unit", "placeholder"):
            shown(m.get(f), where)
        for d in (m.get("values"), m.get("labels"), (m.get("items") or {}).get("values")):
            for v in (d or {}).values() if isinstance(d, dict) else []:
                shown(v, where)
        for pr in m.get("presets") or []:
            if isinstance(pr, list):
                shown(pr[1], where)
        for w in (m.get("modules") or {}).values():
            shown(w.get("label"), where)
        ctx = {"controlCenter.tiles": "tile", "dashboard.home.zones": "zone"}.get(key)
        for w in (m.get("widgets") or {}).values():
            if ctx:
                add(ctx + SEP + w["label"], where)
            shown(w.get("description"), where)
        if m.get("keywords"):
            add("settings keywords" + SEP + " | ".join(m["keywords"]), where)
        # Por que una opcion no se aplica (when, Fase 16 B3).
        for c in m.get("when") or []:
            shown(c.get("reason") if isinstance(c, dict) else None, where)
    return keys


# ---- Comprobacion -------------------------------------------------------------------------
PH = re.compile(r"%(\d|n)")
DATE_PATTERN = re.compile(r"^[dMyhHmsaAPt:.,/ \\n'年月日()-]+$")


def human(s):
    if len(s) < 2 or s.startswith(("#", "/", "~", "qrc", "file:", "image:", "http", "%", "$", "-", ".")):
        return False
    if re.fullmatch(r"[a-z0-9_.:/-]+", s):
        return False
    # Constantes en mayusculas (HH, KEY_UP); varias palabras en mayusculas son texto ("DE UN VISTAZO").
    if re.fullmatch(r"[A-Z0-9_ -]+", s.strip()) and not re.search(r"[A-Z]{2,} [A-Z]{2,}", s):
        return False
    if re.fullmatch(r"[A-Za-z]+", s) and s[0].islower():
        return False
    if re.fullmatch(r"[A-Z][a-z]+(?:[A-Z][a-z0-9]*)+", s):
        return False                                   # identificadores CamelCase (MemTotal, SwapFree)
    if DATE_PATTERN.match(s):
        return False
    if re.fullmatch(r"[\w.@-]+\.(service|socket|target|timer|desktop|json|qml|png|svg)", s):
        return False                                   # unidades de systemd, archivos
    if re.search(r"[{}<>=|\\]|\b(function|return|var|const)\b", s):
        return False
    return bool(re.search(r"[A-Za-zÁÉÍÓÚáéíóúñ]{2,}", s)) and (" " in s or bool(re.search(r"[áéíóúñÁÉÍÓÚ¿¡]", s)) or s[0].isupper())


VISIBLE = re.compile(r"\b(?:text|label|unit|placeholder|hint|status|title|tooltip|detail|note|word|emptyText|sentence|summary|\w+(?:Title|Text|Label|Hint|Placeholder))\s*:\s*" + STR)


def literals(path, allow):
    """Textos visibles fuera de I18n en un archivo convertido."""
    out = []
    for n, line in enumerate(open(path, errors="replace"), 1):
        t = line.strip()
        if t.startswith(("//", "import ", "*")):
            continue
        # Atajos de teclado de Qt (Shortcut) y lineas marcadas como no visibles.
        if re.search(r"\bsequences?\s*:", line) or "// i18n-ok" in line:
            continue
        # Mensajes para quien desarrolla (consola) y codigo de Hyprland: no se muestran.
        if re.search(r"\bconsole\.(log|warn|error|debug|info)\(|\bdispatch\(", line):
            continue
        # Solo se tapan los literales que son claves (el resto de la llamada, con
        # sus parentesis anidados, sigue y se revisa).
        code = core_calls(path, re.sub(r"\s//\s.*$", "", line))
        for rx, _ in CALLS:
            code = rx.sub("I18N(", code)
        # El contexto de un trc con texto variable (trc("keybind", it.text)) no se ve.
        code = TRC_CTX.sub("I18N(", code)
        for s in re.findall(STR, code):
            if human(s) and s not in allow:
                out.append((n, s))
        # Lo que va a una propiedad visible es texto aunque sea una sola palabra en minuscula.
        for s in VISIBLE.findall(code):
            if s and not human(s) and s not in allow and re.search(r"[A-Za-zÁÉÍÓÚáéíóúñ]{2,}", s):
                out.append((n, s))
    return out


def cmd_check(quiet):
    T, Tn = translator()
    keys = extract()
    fails = notes = 0
    def fail(msg):
        nonlocal fails
        fails += 1
        print(T("FAIL %1", msg))
    for lang in available():
        cat = load(lang)
        meta = cat.get("@meta") or {}
        family = meta.get("plural", "one-other")
        if not meta.get("name"):
            fail(T("%1: @meta.name is missing", lang))
        want = {"other": {"other"}, "slavic": {"one", "few", "many"}}.get(family, {"one", "other"})
        for k, e in keys.items():
            v = cat.get(k)
            # Vacio vale solo si la fuente es puro espacio (ja: sin espacio entre frases).
            if v is None or (v == "" and k.split(SEP)[-1].strip()):
                fail(T("%1: missing %2 (%3)", lang, repr(k.replace(SEP, ' | ')), e['where'][0]))
                continue
            src_ph = set(PH.findall(k.split(SEP)[-1]))
            if e["plural"]:
                if not isinstance(v, dict) or not want <= set(v):
                    fail(T("%1: %2 needs the forms %3 (family %4)", lang, repr(k), sorted(want), family))
                    continue
                forms = v.values()
                src_ph |= {"n"}
            else:
                if not isinstance(v, str):
                    fail(T("%1: %2 isn't a plural, it takes a text", lang, repr(k)))
                    continue
                forms = [v]
            for f in forms:
                ph = set(PH.findall(f))
                # %n puede faltar en una forma (ja "other" sin numero no pasa: igual se exige).
                if ph != src_ph:
                    fail(T("%1: %2: placeholders %3 instead of %4: %5", lang, repr(k), sorted(ph), sorted(src_ph), repr(f)))
        for k in cat:
            if k != "@meta" and k not in keys:
                fail(T("%1: old key (nobody uses it): %2", lang, repr(k.replace(SEP, ' | '))))
    # Ningun texto visible fuera de I18n en lo ya convertido.
    try:
        rules = json.load(open(RULES))
    except (OSError, ValueError):
        rules = {"converted": [], "allow": []}
    allow = {a["text"] for a in rules.get("allow", [])}
    for p in sddm_files():
        for n, s2 in literals(p, allow):
            fail(T("%1: visible text outside I18n: %2", f"sddm/{os.path.basename(p)}:{n}", repr(s2)))
    for rel in rules.get("converted", []):
        p = os.path.join(QML, rel)
        if not os.path.exists(p):
            fail(T("converted file that doesn't exist: %1", rel))
            continue
        for n, s in literals(p, allow):
            fail(T("%1: visible text outside I18n: %2", f"{rel}:{n}", repr(s)))
    if not quiet or fails:
        print(T("i18n check: %1 failures · %2 keys · %3 languages (%4)", fails, len(keys), len(available()), ", ".join(['en'] + available())))
    sys.exit(1 if fails else 0)


def cmd_stats():
    keys = extract()
    T, Tn = translator()
    print(T("en (source): %1 keys", len(keys)))
    for lang in available():
        cat = load(lang)
        have = sum(1 for k in keys if cat.get(k) is not None and (cat.get(k) != "" or not k.split(SEP)[-1].strip()))
        print(f"{lang} ({(cat.get('@meta') or {}).get('name', '?')}): {have}/{len(keys)}")


def main():
    T, Tn = translator()
    a = sys.argv[1:]
    if not a:
        die(T("usage: %1", "i18n tr|trn|lang|extract|check|stats|bundle"))
    cmd, rest = a[0], a[1:]
    if cmd == "tr":
        ctx = None
        if rest[:1] == ["--ctx"]:
            if len(rest) < 2:
                die(T("--ctx needs a context"))
            ctx, rest = rest[1], rest[2:]
        if not rest:
            die(T("tr: the text is missing"))
        print(fill(lookup(load(language()), rest[0], ctx), rest[1:]))
    elif cmd == "trn":
        if len(rest) < 3:
            die(T("usage: %1", "i18n trn SINGULAR PLURAL N"))
        try:
            n = float(rest[2])
        except ValueError:
            die(T("trn: N isn't a number"))
        lang = language()
        cat = load(lang)
        v = cat.get(rest[0])
        fam = (cat.get("@meta") or {}).get("plural", "one-other")
        if isinstance(v, dict):
            s = v.get(category(fam, n)) or v.get("other") or rest[1]
        else:
            s = rest[0] if abs(n) == 1 else rest[1]
        num = str(int(n)) if n == int(n) else str(n)
        print(fill(s.replace("%n", num), rest[3:]))
    elif cmd == "lang":
        print(language())
    elif cmd == "extract":
        keys = extract()
        if "--json" in rest:
            print(json.dumps(keys, ensure_ascii=False, indent=1))
        else:
            for k in sorted(keys):
                print(k.replace(SEP, " | "))
    elif cmd == "check":
        cmd_check("--quiet" in rest)
    elif cmd == "stats":
        cmd_stats()
    elif cmd == "bundle":
        if len(rest) < 2:
            die(T("usage: %1", "i18n bundle LANGUAGE FILE..."))
        cat = load(rest[0])
        keys = qml_keys(rest[1:])
        out = {"@meta": cat.get("@meta", {})} if cat else {}
        out.update({k: cat[k] for k in sorted(keys) if k in cat})
        print(json.dumps(out, ensure_ascii=False))
    else:
        die(T("unknown command: %1", cmd))


if __name__ == "__main__":
    main()
