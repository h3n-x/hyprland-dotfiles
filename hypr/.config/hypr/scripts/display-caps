#!/usr/bin/env python3
# Lo que cada pantalla conectada dice que puede (Fase 10 B5), leido de su EDID
# en /sys/class/drm/*/edid (solo lectura, sin root): la pagina Pantallas muestra
# las opciones de color, 10 bits, HDR y VRR solo donde tienen sentido.
#   display-caps            JSON {"<conector>": {digital, maxBpc, hdr, wide, vrr: [min, max] | null, known}}
# "known": false si el EDID no se pudo leer o no trae esos datos (la pagina
# muestra las opciones con una nota). Pruebas: DISPLAY_CAPS_DRM (otra carpeta).
import glob
import json
import os
import sys

DRM = os.environ.get("DISPLAY_CAPS_DRM") or "/sys/class/drm"
BPC = {1: 6, 2: 8, 3: 10, 4: 12, 5: 14, 6: 16}  # byte 20, bits 6-4 (EDID 1.4, entrada digital)


def cta_blocks(b):
    """Bloques de datos de una extension CTA-861 (etiqueta, carga util)."""
    end = b[2]
    i = 4
    while 4 <= i < end and i < len(b):
        tag, n = b[i] >> 5, b[i] & 0x1F
        yield tag, b[i + 1:i + 1 + n]
        i += 1 + n


def caps(edid):
    out = {"digital": None, "maxBpc": None, "hdr": False, "wide": False, "vrr": None, "known": False}
    if len(edid) < 128 or edid[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00":
        return out
    out["known"] = True
    out["digital"] = bool(edid[20] & 0x80)
    if out["digital"] and edid[19] >= 4:  # version 1.4
        out["maxBpc"] = BPC.get((edid[20] >> 4) & 0x07)
    # Descriptor de limites (0xFD): rango de refresco vertical -> VRR posible.
    for d in range(54, 126, 18):
        blk = edid[d:d + 18]
        if blk[0:3] == b"\x00\x00\x00" and blk[3] == 0xFD:
            lo, hi = blk[5], blk[6]
            if blk[4] & 0x02:  # desplazamiento de +255 para el maximo
                hi += 255
            if hi - lo >= 10:
                out["vrr"] = [lo, hi]
    # Extensiones CTA-861: metadatos HDR (etiqueta ext. 6) y colorimetria amplia (5: BT.2020/DCI-P3).
    for e in range(edid[126]):
        b = edid[128 * (e + 1):128 * (e + 2)]
        if len(b) < 4 or b[0] != 0x02:
            continue
        for tag, data in cta_blocks(b):
            if tag == 7 and data:
                if data[0] == 0x06:
                    out["hdr"] = True
                elif data[0] == 0x05 and len(data) > 1 and data[1] & 0xE0:  # BT2020 cYCC/YCC/RGB
                    out["wide"] = True
                elif data[0] == 0x05 and len(data) > 2 and data[2] & 0x80:  # DCI-P3
                    out["wide"] = True
    if out["hdr"]:
        out["wide"] = True
    return out


res = {}
for path in sorted(glob.glob(f"{DRM}/card*-*/edid")):
    conn = os.path.basename(os.path.dirname(path)).split("-", 1)[1]
    try:
        data = open(path, "rb").read()
    except OSError:
        continue
    if not data:
        continue  # vacio = desconectado
    res[conn] = caps(data)
json.dump(res, sys.stdout)
print()
