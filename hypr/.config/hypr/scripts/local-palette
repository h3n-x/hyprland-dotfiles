#!/usr/bin/env bash
# Acento local de una imagen (Fase 12 B4, P12.5; el contrato LocalPalette de
# P8.7 §3.4): la portada de lo que suena hoy, el icono de una app con P5.6.
# Una sola derivacion:
#   1. el color fuente de la imagen (matugen, el mas saturado de los candidatos);
#   2. armonizado hacia el primary del fondo de pantalla en OKLCH: el tono se
#      corre hacia el del fondo la mitad de la diferencia, como mucho 20°;
#   3. los tonos M3 de ese color con el esquema, el modo y el contraste del tema
#      (matugen color hex).
# Invalido (valid: false; la vista usa el acento de siempre) si la fuente casi
# no tiene color, si el texto sobre el acento no llega a 4,5:1, o si el acento
# se confunde con un color de estado (ΔE OKLab x100 < 5 con danger, warning o
# success; antes se prueba corriendo el tono 15° para un lado y para el otro).
#
#   local-palette IMAGEN|URL   -> {valid, accent, onAccent, container, onContainer, source, harmonized}
#   local-palette --icon NOMBRE -> lo mismo para el icono de una app (P5.6): el
#      nombre se busca en el tema de iconos en uso (el IconTheme de la shell,
#      sus Inherits, hicolor y /usr/share/pixmaps); el SVG o el PNG mas grande.
#
# Una URL http(s) (la portada que da el reproductor) se baja una vez a la cache.
# Cache: ~/.cache/dotfiles/local-palette/ (resultado por imagen x fondo x modo x
# contraste x esquema; las imagenes bajadas en art/, los SVG rasterizados en
# icons/). Pruebas: LOCAL_PALETTE_CACHE, QS_COLORS_JSON, STATUS_JSON, SETTINGS_CMD,
# LOCAL_PALETTE_ICON_THEME, LOCAL_PALETTE_ICON_DIRS (bases separadas por ":").
set -uo pipefail

CACHE=${LOCAL_PALETTE_CACHE:-$HOME/.cache/dotfiles/local-palette}
COLORS=${QS_COLORS_JSON:-$HOME/.cache/matugen/quickshell-colors.json}
STATUS=${STATUS_JSON:-$HOME/.cache/matugen/status.json}
SETTINGS=${SETTINGS_CMD:-"$(dirname "$(readlink -f "$0")")/settings"}

src=${1:?uso: local-palette IMAGEN|URL | --icon NOMBRE}
out=""
# Invalido; una vez conocida la clave, tambien queda en la cache (no se recalcula).
invalid() {
    if [[ -n $out ]]; then jq -nc --arg why "$1" '{valid: false, why: $why}' | tee "$out"
    else jq -nc --arg why "$1" '{valid: false, why: $why}'; fi
    exit 0
}
mkdir -p "$CACHE/art"

# ---- Un icono por nombre (P5.6) ------------------------------------------------
if [[ $src == --icon ]]; then
    name=${2:?uso: local-palette --icon NOMBRE}
    theme=${LOCAL_PALETTE_ICON_THEME:-$(grep -oP '^//@ pragma IconTheme \K\S+' "$HOME/.config/quickshell/dotshell/shell.qml" 2>/dev/null)}
    file=$(python3 -I - "$name" "${theme:-hicolor}" "${LOCAL_PALETTE_ICON_DIRS:-$HOME/.local/share/icons:$HOME/.icons:/usr/share/icons}" <<'PY'
import sys, os, re
name, theme, bases = sys.argv[1], sys.argv[2], sys.argv[3].split(":")
if name.startswith("/"):
    print(name if os.path.isfile(name) else ""); sys.exit()
def inherits(t):
    for b in bases:
        f = os.path.join(b, t, "index.theme")
        if os.path.isfile(f):
            m = re.search(r"^Inherits=(.*)$", open(f, errors="ignore").read(), re.M)
            return [x.strip() for x in m.group(1).split(",")] if m else []
    return []
order, todo = [], [theme]
while todo:
    t = todo.pop(0)
    if t in order: continue
    order.append(t); todo += inherits(t)
if "hicolor" not in order: order.append("hicolor")
def size(path):
    m = re.search(r"/(\d+)x\d+/", path)
    return 10000 if path.endswith(".svg") else int(m.group(1)) if m else 0
for t in order:
    found = []
    for b in bases:
        root = os.path.join(b, t)
        if not os.path.isdir(root): continue
        for d, _, files in os.walk(root):
            for ext in (".svg", ".png"):
                if name + ext in files: found.append(os.path.join(d, name + ext))
    if found:
        print(max(found, key=size)); sys.exit()
for ext in (".png", ".svg", ".xpm"):
    p = "/usr/share/pixmaps/" + name + ext
    if os.path.isfile(p): print(p); sys.exit()
print("")
PY
)
    [[ -n $file ]] || invalid "no icon"
    # Un SVG se rasteriza una vez (la cache de abajo se fija en su tamano y fecha).
    if [[ $file == *.svg ]]; then
        png="$CACHE/icons/$(printf '%s' "$file" | md5sum | cut -d' ' -f1).png"
        if [[ ! -s $png || $png -ot $file ]]; then
            mkdir -p "$CACHE/icons"
            magick -background none "$file" -resize 128x128 "$png" 2>/dev/null || invalid "the icon couldn't be read"
        fi
        file=$png
    fi
    src=$file
fi

# ---- La imagen ---------------------------------------------------------------
case $src in
file://*) src=${src#file://}; src=$(printf '%b' "${src//%/\\x}") ;;
http://*|https://*)
    f="$CACHE/art/$(printf '%s' "$src" | md5sum | cut -d' ' -f1)"
    if [[ ! -s $f ]]; then
        curl -sS --max-time 10 -A "dotfiles-shell (Quickshell; portada)" -o "$f.part" "$src" 2>/dev/null && mv -f "$f.part" "$f" \
            || { rm -f "$f.part"; invalid "the cover couldn't be downloaded"; }
    fi
    src=$f ;;
esac
[[ -r $src ]] || invalid "no image"

# ---- Clave de cache: la imagen (tamano y fecha) y el tema ------------------
wp=$(jq -r '.primary // empty' "$COLORS" 2>/dev/null)
mode=$(jq -r '.mode // "dark"' "$COLORS" 2>/dev/null)
contrast=$(jq -r '.contrast // 0' "$COLORS" 2>/dev/null)
scheme=$("$SETTINGS" get appearance.scheme 2>/dev/null || true); scheme=${scheme:-scheme-tonal-spot}
[[ -n $wp ]] || invalid "no theme colors"
key=$(printf '%s\t%s\t%s\t%s\t%s\t%s' "$(readlink -f "$src")" "$(stat -c '%s %Y' "$src")" "$wp" "$mode" "$contrast" "$scheme" | md5sum | cut -d' ' -f1)
out="$CACHE/$key.json"
[[ -s $out ]] && { cat "$out"; exit 0; }

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
magick "$src[0]" -resize 128x128 "$tmp/s.png" 2>/dev/null || invalid "the image couldn't be read"
# Sin colores en la imagen matugen devuelve su color de reserva: gris, asi queda invalido.
source=$(matugen image "$tmp/s.png" --dry-run -j hex -m "$mode" --prefer saturation --fallback-color "#808080" 2>/dev/null | jq -r '.colors.source_color.default.color // empty')
[[ -n $source ]] || invalid "no source color"

tones() { # color -> "accent onAccent container onContainer"
    matugen color hex "$1" --dry-run -j hex -t "$scheme" -m "$mode" --contrast "$contrast" 2>/dev/null \
        | jq -r --arg m "$mode" '[.colors.primary[$m].color, .colors.on_primary[$m].color, .colors.primary_container[$m].color, .colors.on_primary_container[$m].color] | join(" ")'
}
st=$(jq -r '[.status.error.default.hex, .status.warning.default.hex, .status.success.default.hex] | join(" ")' "$STATUS" 2>/dev/null)

# ---- OKLCH: armonizar, revisar color, contraste y estados -------------------
python3 -I - "$source" "$wp" "$st" "$tmp" <<'PY' > "$tmp/plan" || invalid "colorless source"
import sys, math
def lin(c): return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
def hexrgb(h): h = h.lstrip('#'); return [int(h[i:i+2], 16) / 255 for i in (0, 2, 4)]
def oklab(h):
    r, g, b = (lin(c) for c in hexrgb(h))
    l = 0.4122214708*r + 0.5363325363*g + 0.0514459929*b
    m = 0.2119034982*r + 0.6806995451*g + 0.1073969566*b
    s = 0.0883024619*r + 0.2817188376*g + 0.6299787005*b
    l, m, s = (x ** (1/3) for x in (l, m, s))
    return (0.2104542553*l + 0.7936177850*m - 0.0040720468*s,
            1.9779984951*l - 2.4285922050*m + 0.4505937099*s,
            0.0259040371*l + 0.7827717662*m - 0.8086757660*s)
def tohex(L, a, b):
    l = (L + 0.3963377774*a + 0.2158037573*b) ** 3
    m = (L - 0.1055613458*a - 0.0638541728*b) ** 3
    s = (L - 0.0894841775*a - 1.2914855480*b) ** 3
    rgb = (4.0767416621*l - 3.3077115913*m + 0.2309699292*s,
           -1.2684380046*l + 2.6097574011*m - 0.3413193965*s,
           -0.0041960863*l - 0.7034186147*m + 1.7076147010*s)
    def enc(c):
        c = max(0.0, min(1.0, c))
        return 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1/2.4) - 0.055
    return '#' + ''.join('%02x' % round(enc(c) * 255) for c in rgb)
def lch(h):
    L, a, b = oklab(h); return L, math.hypot(a, b), math.degrees(math.atan2(b, a)) % 360
def fromlch(L, C, H): return tohex(L, C * math.cos(math.radians(H)), C * math.sin(math.radians(H)))
src, wp, st = sys.argv[1], sys.argv[2], sys.argv[3].split()
L, C, H = lch(src)
if C < 0.04: sys.exit(1)                  # casi gris: el acento del fondo queda
_, _, Hw = lch(wp)
d = (Hw - H + 540) % 360 - 180            # diferencia con signo, -180..180
H2 = (H + max(-20, min(20, d / 2))) % 360  # la mitad, como mucho 20°
C2 = min(C, 0.20)                          # sin colores chillones
# Candidatos: el armonizado y, por si cae cerca de un estado, corrido 15° a cada lado.
for dh in (0, 15, -15):
    print(fromlch(L, C2, (H2 + dh) % 360))
PY
# ΔE (OKLab x100) y contraste WCAG, del lado de bash con el mismo python.
check() { # acento onAcento -> 0 si sirve
    python3 -I - "$1" "$2" "$st" <<'PY'
import sys, math
def lin(c): return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
def rgb(h): h = h.lstrip('#'); return [lin(int(h[i:i+2], 16) / 255) for i in (0, 2, 4)]
def lum(h): r, g, b = rgb(h); return 0.2126*r + 0.7152*g + 0.0722*b
def lab(h):
    r, g, b = rgb(h)
    l = (0.4122214708*r + 0.5363325363*g + 0.0514459929*b) ** (1/3)
    m = (0.2119034982*r + 0.6806995451*g + 0.1073969566*b) ** (1/3)
    s = (0.0883024619*r + 0.2817188376*g + 0.6299787005*b) ** (1/3)
    return (0.2104542553*l + 0.7936177850*m - 0.0040720468*s, 1.9779984951*l - 2.4285922050*m + 0.4505937099*s,
            0.0259040371*l + 0.7827717662*m - 0.8086757660*s)
acc, on, st = sys.argv[1], sys.argv[2], sys.argv[3].split()
a, b = sorted((lum(acc), lum(on)))
if (b + 0.05) / (a + 0.05) < 4.5: sys.exit(2)
for s in st:
    if 100 * math.dist(lab(acc), lab(s)) < 5: sys.exit(3)
PY
}
why="mistaken for a status color"
while read -r cand; do
    read -r acc on cont oncont <<<"$(tones "$cand")"
    [[ -n ${oncont:-} ]] || continue
    check "$acc" "$on"; r=$?
    if [[ $r == 0 ]]; then
        jq -nc --arg a "$acc" --arg o "$on" --arg c "$cont" --arg oc "$oncont" --arg s "$source" --arg h "$cand" \
            '{valid: true, accent: $a, onAccent: $o, container: $c, onContainer: $oc, source: $s, harmonized: $h}' > "$out.part" \
            && mv -f "$out.part" "$out" && cat "$out"
        exit 0
    fi
    [[ $r == 2 ]] && why="low contrast"
done < "$tmp/plan"
jq -nc --arg why "$why" --arg s "$source" '{valid: false, why: $why, source: $s}' | tee "$out"
