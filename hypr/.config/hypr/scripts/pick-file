#!/usr/bin/env python3
# Elegir un archivo o una carpeta con el selector del portal (Fase 10 B2):
# org.freedesktop.portal.FileChooser, que aca atiende xdg-desktop-portal-gtk
# (el selector de GTK, con el tema de matugen como el resto de las apps). Lo
# usa el centro de configuracion (avatar; carpetas de capturas). qt6ct no da
# un dialogo nativo a Qt (standard_dialogs=default) y el de Qt Quick no sigue
# el design system: por eso el portal, directo.
#
#   pick-file [--folder] [--images] [--title <texto>] [--start <carpeta>]
#
# Imprime la ruta elegida. Salida: 0 elegida, 1 cancelada, 2 error (motivo
# en stderr).
import argparse
import os
import sys
import uuid


# Mensajes en el idioma del usuario (Fase 15 B4): scripts/i18n, texto fuente en ingles.
def _i18n():
    import importlib.machinery, importlib.util
    sys.dont_write_bytecode = True  # sin __pycache__ junto a los scripts
    loader = importlib.machinery.SourceFileLoader("i18n", os.path.join(os.path.dirname(os.path.realpath(__file__)), "i18n"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("i18n", loader))
    loader.exec_module(mod)
    return mod
T, Tn = _i18n().translator()

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

ap = argparse.ArgumentParser(prog="pick-file")
ap.add_argument("--folder", action="store_true", help=T("choose a folder"))
ap.add_argument("--images", action="store_true", help=T("images only"))
ap.add_argument("--title", default="")
ap.add_argument("--start", default="")
a = ap.parse_args()

try:
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
except GLib.Error as e:
    print("pick-file: " + T("no session bus: %1", e.message), file=sys.stderr)
    sys.exit(2)

token = "pickfile_" + uuid.uuid4().hex
sender = bus.get_unique_name()[1:].replace(".", "_")
handle = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
loop = GLib.MainLoop()
result = {"code": 2, "path": ""}


def on_response(_conn, _sender, _path, _iface, _signal, params, _data):
    code, results = params.unpack()
    uris = results.get("uris") or []
    if code == 0 and uris:
        f = Gio.File.new_for_uri(uris[0])
        result["path"] = f.get_path() or ""
        result["code"] = 0 if result["path"] else 2
    else:
        result["code"] = 1 if code == 1 else 2
    loop.quit()


# Suscrito antes de pedir: la respuesta no se pierde aunque llegue enseguida.
bus.signal_subscribe("org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request", "Response",
                     handle, None, Gio.DBusSignalFlags.NO_MATCH_RULE, on_response, None)

opts = {"handle_token": GLib.Variant("s", token), "modal": GLib.Variant("b", True)}
if a.folder:
    opts["directory"] = GLib.Variant("b", True)
if a.images:
    pats = [(0, p) for p in ("*.png", "*.jpg", "*.jpeg", "*.webp", "*.gif", "*.bmp")]
    flt = ("Imágenes", pats)
    opts["filters"] = GLib.Variant("a(sa(us))", [flt])
    opts["current_filter"] = GLib.Variant("(sa(us))", flt)
start = os.path.expanduser(a.start) if a.start else ""
if start and os.path.isdir(start):
    opts["current_folder"] = GLib.Variant("ay", start.encode() + b"\0")
# El titulo de la ventana del portal, en el idioma del usuario.
title = a.title or (T("Choose a folder") if a.folder else T("Choose a file"))

try:
    bus.call_sync("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
                  "org.freedesktop.portal.FileChooser", "OpenFile",
                  GLib.Variant("(ssa{sv})", ("", title, opts)), None, Gio.DBusCallFlags.NONE, -1, None)
except GLib.Error as e:
    print("pick-file: " + T("the portal didn't answer: %1", e.message), file=sys.stderr)
    sys.exit(2)

loop.run()
if result["code"] == 0:
    print(result["path"])
elif result["code"] == 2:
    print("pick-file: " + T("the portal returned an error"), file=sys.stderr)
sys.exit(result["code"])
