#!/usr/bin/env bash
# Opciones del ecosistema (Fase 8 B1, P8.1): la unica implementacion de las
# reglas (tipos, rangos, migraciones, cuarentena, escritura).
#
#   settings get <clave>            valor efectivo (rapido: jq sobre la cache)
#   settings set <clave> <json>     valida y guarda (un valor igual al de fabrica
#                                   se borra: "modificado" = la clave existe)
#   settings reset <clave>          vuelve al valor de fabrica
#   settings reset-category <cat>   todas las claves de una categoria
#   settings dump                   regenera la cache efectiva y la imprime
#   settings check                  valida el esquema (y resume el archivo del usuario)
#   settings keys                   claves del esquema (drift check)
#   settings path                   rutas en uso
#
# Archivos (clases, ver ARCHITECTURE):
#   esquema   dotshell/data/settings.schema.json      SOURCE: defaults y metadatos
#   usuario   ~/.config/dotfiles/settings.json        solo lo que el usuario cambio
#   efectivo  ~/.cache/dotfiles/settings.effective.json  CACHE: todo resuelto
# Nadie lee settings.json directamente: la shell (SettingsState) y los scripts
# leen la cache efectiva; todo lo que escribe pasa por aca. Un valor invalido
# no se aplica ni se borra (cuarentena, queda en "problems"). Sin secretos.
# Las claves que van a Hyprland o a hypridle ("hypr"/"idle" en el esquema, Fase
# 10 B3) y las de pantallas y luz nocturna ("applyTo", B5) se aplican despues de
# escribir: settings-apply changed <claves>.
# Pruebas: SETTINGS_SCHEMA, SETTINGS_MIGRATIONS, SETTINGS_FILE,
# SETTINGS_EFFECTIVE, SETTINGS_LOCK, SETTINGS_APPLY (otro aplicador; vacio =
# ninguno).
set -uo pipefail

SCHEMA=${SETTINGS_SCHEMA:-$HOME/.config/quickshell/dotshell/data/settings.schema.json}
MIGRATIONS=${SETTINGS_MIGRATIONS:-$(dirname "$SCHEMA")/settings.migrations.json}
USER_FILE=${SETTINGS_FILE:-$HOME/.config/dotfiles/settings.json}
EFFECTIVE=${SETTINGS_EFFECTIVE:-${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/settings.effective.json}
LOCK=${SETTINGS_LOCK:-${XDG_RUNTIME_DIR:-/tmp}/dotfiles/settings.lock}
APPLIER=${SETTINGS_APPLY-$(dirname "$(readlink -f "$0")")/settings-apply}
I18N=$(dirname "$(readlink -f "$0")")/i18n
export SCHEMA MIGRATIONS USER_FILE EFFECTIVE LOCK APPLIER I18N

# La cache vale si es mas nueva que todo lo que la produce.
fresh() {
    [[ -f $EFFECTIVE ]] || return 1
    local f
    for f in "$SCHEMA" "$MIGRATIONS" "$USER_FILE"; do
        [[ -e $f && $f -nt $EFFECTIVE ]] && return 1
    done
    return 0
}

engine() {
    python3 - "$@" <<'PY'
import datetime, fcntl, json, os, re, sys, tempfile

SCHEMA = os.environ["SCHEMA"]; MIGRATIONS = os.environ["MIGRATIONS"]
USER_FILE = os.environ["USER_FILE"]; EFFECTIVE = os.environ["EFFECTIVE"]; LOCK = os.environ["LOCK"]
APPLIER = os.environ.get("APPLIER", "")
TYPES = {"bool", "int", "number", "string", "enum", "path", "list", "color", "location", "time", "outputs", "barLayout", "homeZones", "tiles"}
# Campos de una regla de pantalla (Fase 10 B5; los que hl.monitor acepta, verificados en V0).
OUTPUT_CM = {"auto", "srgb", "dcip3", "dp3", "adobe", "wide", "edid", "hdr", "hdredid"}
APPLY = {"live", "next-use", "reload-shell", "relogin", "reboot"}
SCOPES = {"user", "login", "lock"}


# Mensajes en el idioma del usuario (Fase 15 B4; texto fuente en ingles). El idioma
# sale del archivo del usuario, nunca de "settings get": el motor no se consulta a si mismo.
def _user_language():
    try:
        with open(USER_FILE) as f:
            return (json.load(f).get("values") or {}).get("appearance.language", "auto")
    except (OSError, ValueError, AttributeError):
        return "auto"
def _i18n():
    import importlib.machinery, importlib.util
    sys.dont_write_bytecode = True  # sin __pycache__ junto a los scripts
    loader = importlib.machinery.SourceFileLoader("i18n", os.environ["I18N"])
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("i18n", loader))
    loader.exec_module(mod)
    return mod
T, Tn = _i18n().translator(_user_language)


def die(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f), None
    except FileNotFoundError:
        return default, None
    except (OSError, ValueError) as e:
        return default, str(e)


def schema():
    s, err = load_json(SCHEMA, None)
    if s is None:
        die(T("unreadable schema: %1 (%2)", err or T("it doesn't exist"), SCHEMA), 1)
    return s


def schema_problems(s):
    """Errores del esquema mismo (check): tipos, categorias, prefijos, defaults."""
    out = []
    cats = s.get("categories", {})
    if not isinstance(s.get("version"), int):
        out.append(T("version: missing or not an integer"))
    for key, m in s.get("keys", {}).items():
        t = m.get("type")
        if t not in TYPES:
            out.append(T("%1: unknown type %2", key, repr(t)))
            continue
        cat = m.get("category")
        if cat not in cats:
            out.append(T("%1: unknown category %2", key, repr(cat)))
        elif not key.startswith(cat + "."):
            out.append(T("%1: the prefix doesn't match the category %2", key, repr(cat)))
        if not m.get("label"):
            out.append(T("%1: label is missing", key))
        if m.get("apply", "live") not in APPLY:
            out.append(T("%1: unknown apply %2", key, repr(m.get('apply'))))
        if m.get("scope", "user") not in SCOPES:
            out.append(T("%1: unknown scope %2", key, repr(m.get('scope'))))
        if t == "enum" and not isinstance(m.get("values"), dict):
            out.append(T("%1: enum without values", key))
        if "min" in m and "max" in m and m["min"] > m["max"]:
            out.append(f"{key}: min > max")
        if "default" not in m:
            out.append(T("%1: default is missing", key))
        else:
            ok, _, why = validate(m, m["default"])
            if not ok:
                out.append(T("%1: invalid default (%2)", key, why))
    return out


def validate(m, v):
    """(ok, valor efectivo, motivo) segun el tipo y los limites del esquema."""
    t = m["type"]
    # "nullable": null es un valor valido (sin elegir todavia; Fase 10 B4).
    if v is None and m.get("nullable"):
        return True, None, None
    def rng(x):
        if "min" in m and x < m["min"]:
            return T("less than %1", m['min'])
        if "max" in m and x > m["max"]:
            return T("greater than %1", m['max'])
        return None
    if t == "bool":
        return (True, v, None) if isinstance(v, bool) else (False, None, "no es verdadero/falso")
    if t == "int":
        if isinstance(v, bool) or not isinstance(v, int):
            return False, None, T("not an integer")
        r = rng(v)
        return (False, None, r) if r else (True, v, None)
    if t == "number":
        if isinstance(v, bool) or not isinstance(v, (int, float)):
            return False, None, T("not a number")
        r = rng(v)
        return (False, None, r) if r else (True, v, None)
    if t == "string":
        if not isinstance(v, str):
            return False, None, T("not text")
        if "maxLength" in m and len(v) > m["maxLength"]:
            return False, None, T("more than %1 characters", m['maxLength'])
        if "pattern" in m and not re.fullmatch(m["pattern"], v):
            return False, None, T("invalid format")
        return True, v, None
    if t == "enum":
        return (True, v, None) if isinstance(v, str) and v in m["values"] else (False, None, T("not one of: %1", ", ".join(m['values'])))
    if t == "path":
        if not isinstance(v, str) or not v:
            return False, None, T("not a path")
        p = os.path.expanduser(os.path.expandvars(v))
        return (True, p, None) if os.path.isabs(p) else (False, None, T("the path isn't absolute"))
    if t == "list":
        if not isinstance(v, list):
            return False, None, T("not a list")
        if "maxItems" in m and len(v) > m["maxItems"]:
            return False, None, T("more than %1 items", m['maxItems'])
        item = dict(m.get("items", {"type": "string"}))
        out = []
        for x in v:
            ok, val, why = validate(item, x)
            if not ok:
                return False, None, T("invalid item (%1)", why)
            # "unique": cada elemento una vez (Fase 11 B5: apps y carpetas fijadas).
            if m.get("unique") and val in out:
                return False, None, T("%1 appears twice", repr(x))
            out.append(val)
        return True, out, None
    if t == "color":
        if isinstance(v, str) and (re.fullmatch(r"#[0-9a-fA-F]{6}", v) or re.fullmatch(r"[a-z][A-Za-z]*", v)):
            return True, v, None
        return False, None, T("not #rrggbb nor a color role")
    if t == "location":
        # Ciudad del clima (Fase 10 B4): {name, detail?, lat, lon}.
        num = lambda x: isinstance(x, (int, float)) and not isinstance(x, bool)
        if (isinstance(v, dict) and isinstance(v.get("name"), str) and v["name"] and num(v.get("lat")) and num(v.get("lon"))
                and -90 <= v["lat"] <= 90 and -180 <= v["lon"] <= 180 and isinstance(v.get("detail", ""), str)):
            return True, {k: v[k] for k in ("name", "detail", "lat", "lon") if k in v}, None
        return False, None, T("not a location {name, lat, lon}")
    if t == "time":
        # Hora del dia "HH:MM" (luz nocturna, Fase 10 B5).
        if isinstance(v, str) and re.fullmatch(r"([01][0-9]|2[0-3]):[0-5][0-9]", v):
            return True, v, None
        return False, None, T("not an HH:MM time")
    if t == "outputs":
        return validate_outputs(v)
    if t == "barLayout":
        return validate_bar_layout(m, v)
    # Fase 11 B6: los ajustes rapidos del centro de control son la misma clase de lista (un validador).
    if t in ("homeZones", "tiles"):
        return validate_home_zones(m, v)
    return False, None, T("unknown type")


def validate_bar_layout(m, v):
    """Disposicion de la barra (Fase 11 B1): {start, center, end} de "spacer", un modulo "bare" (dibuja su
    propia forma) o {"pill": [modulos]}. Cada modulo una vez como mucho; los del registro del esquema."""
    mods = m.get("modules", {})
    if not isinstance(v, dict) or set(v) != {"start", "center", "end"}:
        return False, None, T("not {start, center, end}")
    seen = set()
    for sec in ("start", "center", "end"):
        if not isinstance(v[sec], list):
            return False, None, T("%1: not a list", sec)
        for it in v[sec]:
            ids = []
            if it == "spacer":
                continue
            if isinstance(it, str):
                if it not in mods:
                    return False, None, T("unknown module %1", repr(it))
                if not mods[it].get("bare"):
                    return False, None, T("%1 goes inside a pill", it)
                ids = [it]
            elif isinstance(it, dict) and set(it) == {"pill"} and isinstance(it["pill"], list) and it["pill"]:
                for x in it["pill"]:
                    if x not in mods:
                        return False, None, T("unknown module %1", repr(x))
                    if mods[x].get("bare"):
                        return False, None, T("%1 doesn't go inside a pill", x)
                ids = it["pill"]
            else:
                return False, None, T("%1: invalid item", sec)
            for x in ids:
                if x in seen:
                    return False, None, T("%1 appears twice", x)
                seen.add(x)
    return True, {sec: list(v[sec]) for sec in ("start", "center", "end")}, None


def validate_home_zones(m, v):
    """Lista ordenada de {"id", "size"} contra el registro "widgets" de su clave: las zonas de Inicio
    (Fase 11 B4) y los ajustes rapidos del centro de control (B6). Cada uno una vez como mucho, con un
    tamano que admite. Vacia = ninguno."""
    widgets = m.get("widgets", {})
    if not isinstance(v, list):
        return False, None, T("not a list of zones")
    seen, out = set(), []
    for it in v:
        if not isinstance(it, dict) or set(it) != {"id", "size"}:
            return False, None, T("invalid zone ({id, size} expected)")
        wid, size = it["id"], it["size"]
        if wid not in widgets:
            return False, None, T("unknown widget %1", repr(wid))
        if size not in widgets[wid].get("sizes", []):
            return False, None, T("%1: invalid size (%2)", wid, repr(size))
        if wid in seen:
            return False, None, T("%1 appears twice", wid)
        seen.add(wid)
        out.append({"id": wid, "size": size})
    return True, out, None


def validate_outputs(v):
    """Reglas de pantalla por salida (Fase 10 B5): {"desc:<descripcion>" | "<conector>": {campo: valor}}.
    Un desc: vacio coincidiria con todas las pantallas: se rechaza."""
    num = lambda x: isinstance(x, (int, float)) and not isinstance(x, bool)
    if not isinstance(v, dict):
        return False, None, T("not a map of displays")
    out = {}
    for name, r in v.items():
        if not isinstance(name, str) or not name.strip() or name.strip() == "desc:" or name.startswith("desc: "):
            return False, None, T("display without a name (%1)", repr(name))
        if not isinstance(r, dict):
            return False, None, T("%1: not a rule", name)
        checks = {
            "mode": lambda x: isinstance(x, str) and (x in ("preferred", "highres", "highrr", "maxwidth")
                                                     or re.fullmatch(r"\d+x\d+(@\d+(\.\d+)?)?", x)),
            "position": lambda x: isinstance(x, str) and (x in ("auto", "auto-right", "auto-left", "auto-up", "auto-down")
                                                         or re.fullmatch(r"-?\d+x-?\d+", x)),
            "scale": lambda x: x == "auto" or (num(x) and 0.25 <= x <= 10),
            "transform": lambda x: isinstance(x, int) and not isinstance(x, bool) and 0 <= x <= 7,
            "enabled": lambda x: isinstance(x, bool),
            "mirror": lambda x: isinstance(x, str),
            "vrr": lambda x: isinstance(x, int) and not isinstance(x, bool) and 0 <= x <= 2,
            "bitdepth": lambda x: x in (8, 10),
            "cm": lambda x: x in OUTPUT_CM,
            "sdrbrightness": lambda x: num(x) and 0.5 <= x <= 3,
            "sdrsaturation": lambda x: num(x) and 0.5 <= x <= 3,
            "sdr_min_luminance": lambda x: num(x) and 0 <= x <= 10,
            "sdr_max_luminance": lambda x: num(x) and 10 <= x <= 10000,
            "min_luminance": lambda x: num(x) and 0 <= x <= 10,
            "max_luminance": lambda x: num(x) and 10 <= x <= 10000,
            "max_avg_luminance": lambda x: num(x) and 10 <= x <= 10000,
        }
        for f, val in r.items():
            if f not in checks:
                return False, None, T("%1: unknown field %2", name, repr(f))
            if not checks[f](val):
                return False, None, T("%1: invalid %2 (%3)", name, f, repr(val))
        out[name.strip()] = dict(r)
    return True, out, None


def migrate(user, s):
    """Aplica las migraciones pendientes (datos en settings.migrations.json)."""
    migs, err = load_json(MIGRATIONS, [])
    notes = []
    if err:
        notes.append({"key": None, "reason": T("unreadable migrations: %1", err)})
        migs = []
    version = user.get("version", 0) if isinstance(user.get("version", 0), int) else 0
    values = user.get("values", {})
    for mg in sorted(migs, key=lambda x: x.get("to", 0)):
        if version >= mg.get("to", 0):
            continue
        for old, new in mg.get("rename", {}).items():
            if old in values and new not in values:
                values[new] = values.pop(old)
        for key, conv in mg.get("convert", {}).items():
            if key in values and "map" in conv and values[key] in conv["map"]:
                values[key] = conv["map"][values[key]]
        # layoutRemove (Fase 11 B1): una opcion vieja en false saca su modulo de una disposicion
        # (bar.show.<id> -> bar.layout; B4: dashboard.home.<zona> -> dashboard.home.zones);
        # la opcion vieja se borra con el valor que tenga.
        lr = mg.get("layoutRemove")
        if lr:
            target = lr["target"]
            gone = [mid for old, mid in lr["keys"].items() if values.get(old) is False]
            for old in lr["keys"]:
                values.pop(old, None)
            if gone:
                lay = values.get(target, s["keys"].get(target, {}).get("default"))
                lay = json.loads(json.dumps(lay))
                # Una lista de zonas (dashboard.home.zones, Fase 11 B4): se quitan esas zonas.
                zones = isinstance(lay, list)
                if zones:
                    lay = {"zones": lay}
                for sec in lay:
                    out = []
                    for it in lay[sec]:
                        if isinstance(it, dict) and "pill" in it:
                            it["pill"] = [x for x in it["pill"] if x not in gone]
                            if it["pill"]:
                                out.append(it)
                        elif (it.get("id") if isinstance(it, dict) else it) not in gone:
                            out.append(it)
                    lay[sec] = out
                values[target] = lay["zones"] if zones else lay
        # listAdd (Fase 11 B5): agrega elementos al principio o al final de una lista ya guardada
        # (sin guardar, la de fabrica ya los trae); los que ya estan no se repiten.
        la = mg.get("listAdd")
        if la and isinstance(values.get(la["target"]), list):
            cur = values[la["target"]]
            ids = lambda l: [x.get("id") if isinstance(x, dict) else x for x in l]
            start = [x for x in la.get("start", []) if (x.get("id") if isinstance(x, dict) else x) not in ids(cur)]
            end = [x for x in la.get("end", []) if (x.get("id") if isinstance(x, dict) else x) not in ids(cur)]
            values[la["target"]] = start + cur + end
        version = mg["to"]
    user["values"] = values
    user["version"] = max(version, user.get("version", 0) if isinstance(user.get("version"), int) else 0)
    if user["version"] > s["version"]:
        notes.append({"key": None, "reason": T("the file is from a newer version (%1) than the schema (%2)", user['version'], s['version'])})
    return user, notes


def read_user(s):
    raw, err = load_json(USER_FILE, {})
    problems = []
    broken = False
    if err:
        broken = True
        problems.append({"key": None, "reason": T("unreadable file, the default values are used: %1", err)})
        raw = {}
    if not isinstance(raw, dict) or not isinstance(raw.get("values", {}), dict):
        broken = True
        problems.append({"key": None, "reason": T("the file doesn't have the {version, values} shape")})
        raw = {}
    raw.setdefault("values", {})
    user, notes = migrate(raw, s)
    return user, problems + notes, broken


def effective(s, user, problems):
    keys = s["keys"]
    values, modified = {}, []
    for key, m in keys.items():
        _, values[key], _ = validate(m, m["default"])
    for key, v in user["values"].items():
        if key not in keys:
            problems.append({"key": key, "value": v, "reason": T("unknown key (kept, not applied)")})
            continue
        ok, val, why = validate(keys[key], v)
        if ok:
            values[key] = val
            if v != keys[key]["default"]:
                modified.append(key)
        else:
            problems.append({"key": key, "value": v, "reason": T("%1 (the default value is used)", why)})
    return {"schemaVersion": s["version"], "values": values, "modified": sorted(modified), "problems": problems}


def atomic_write(path, text):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def dump(quiet=False):
    s = schema()
    user, problems, _ = read_user(s)
    eff = effective(s, user, problems)
    text = json.dumps(eff, ensure_ascii=False, indent=1, sort_keys=True) + "\n"
    old, _ = load_json(EFFECTIVE, None)
    if old == eff:
        os.utime(EFFECTIVE)   # mismo contenido: solo marca que esta al dia
    else:
        atomic_write(EFFECTIVE, text)
    if not quiet:
        sys.stdout.write(text)


def locked(fn):
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    with open(LOCK, "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        return fn()


def write_user(change):
    """Relee bajo el lock, aplica el cambio y escribe (nunca los valores ajenos)."""
    s = schema()
    def run():
        user, problems, broken = read_user(s)
        before = effective(s, user, problems)["values"]
        if broken and os.path.exists(USER_FILE):
            stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
            os.replace(USER_FILE, f"{USER_FILE}.broken-{stamp}")
        change(s, user["values"])
        out = {"version": max(s["version"], user.get("version", 0)), "values": dict(sorted(user["values"].items()))}
        atomic_write(USER_FILE, json.dumps(out, ensure_ascii=False, indent=2) + "\n")
        dump(quiet=True)
        return before
    before = locked(run)
    # Fuera del lock: lo que va a Hyprland o a hypridle se aplica ya. Un error
    # de aplicacion se avisa pero no deshace lo guardado.
    after, _ = load_json(EFFECTIVE, {"values": {}})
    changed = [k for k, m in s["keys"].items() if (m.get("hypr") or m.get("idle") or m.get("applyTo"))
               and before.get(k) != after.get("values", {}).get(k)]
    if changed and APPLIER:
        import subprocess
        r = subprocess.run([APPLIER, "changed"] + changed, capture_output=True, text=True)
        if r.returncode != 0 or r.stderr.strip():
            print(T("apply: %1", (r.stderr or r.stdout).strip()), file=sys.stderr)


def cmd_set(key, text):
    s = schema()
    if key not in s["keys"]:
        die(T("unknown key: %1", key))
    try:
        value = json.loads(text)
    except ValueError:
        value = text            # texto suelto: settings set capture.screenshotsDir ~/Capturas
    m = s["keys"][key]
    ok, _, why = validate(m, value)
    if not ok:
        die(f"{key}: " + T("%1; not saved", why))
    def change(s, values):
        if value == m["default"]:
            values.pop(key, None)
        else:
            values[key] = value
    write_user(change)


def cmd_reset(key):
    write_user(lambda s, values: values.pop(key, None))


def cmd_reset_category(cat):
    s = schema()
    if cat not in s.get("categories", {}):
        die(T("unknown category: %1", cat))
    def change(s, values):
        for k in [k for k in values if k.startswith(cat + ".")]:
            values.pop(k)
    write_user(change)


def cmd_check():
    s = schema()
    errs = schema_problems(s)
    for e in errs:
        print(e, file=sys.stderr)
    user, problems, _ = read_user(s)
    eff = effective(s, user, problems)
    print(T("%1 keys in %2 categories; schema: %3 errors; user file: %4 changed, %5 problems",
            len(s['keys']), len(s.get('categories', {})), len(errs), len(eff['modified']), len(eff['problems'])))
    for p in eff["problems"]:
        print("  " + T("problem: %1: %2", p.get('key'), p['reason']))
    sys.exit(1 if errs else 0)


args = sys.argv[1:]
cmd = args[0] if args else ""
if cmd == "dump":
    dump()
elif cmd == "set" and len(args) == 3:
    cmd_set(args[1], args[2])
elif cmd == "reset" and len(args) == 2:
    cmd_reset(args[1])
elif cmd == "reset-category" and len(args) == 2:
    cmd_reset_category(args[1])
elif cmd == "check":
    cmd_check()
elif cmd == "keys":
    print("\n".join(sorted(schema()["keys"])))
else:
    die(T("usage: %1", "settings get|set|reset|reset-category|dump|check|keys|path"))
PY
}

case "${1:-}" in
    get)
        [[ -n ${2:-} ]] || { "$I18N" tr "usage: %1" "settings get <key>" >&2; exit 2; }
        fresh || engine dump >/dev/null || exit 1
        # Texto tal cual; lo demas en JSON (true, 6, 1.5, [..]). Clave desconocida: exit 2.
        jq -r --arg k "$2" 'if (.values | has($k)) then .values[$k] | (if type == "string" then . else tojson end)
                            else error("clave desconocida") end' "$EFFECTIVE" 2>/dev/null ||
            { "$I18N" tr "unknown key: %1" "$2" >&2; exit 2; }
        ;;
    path)
        printf 'esquema     %s\nmigraciones %s\nusuario     %s\nefectivo    %s\nlock        %s\n' "$SCHEMA" "$MIGRATIONS" "$USER_FILE" "$EFFECTIVE" "$LOCK"
        ;;
    *)
        engine "$@"
        ;;
esac
