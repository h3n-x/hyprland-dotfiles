#!/usr/bin/env bash
# Paleta del sistema de diseno (Fase 8 B2, P8.7): colores de estado fijos y la
# validacion obligatoria del sistema de color (palette check).
#
#   palette status [--mode dark|light] [--contrast C] [--write]
#       Colores de estado (error, warning, success y sus contenedores): semillas
#       de palette.rules.json por scheme-fidelity, SIEMPRE con el contraste fijo
#       de las reglas. Solo cambian con el modo: nunca con el wallpaper, el
#       esquema, el contraste elegido ni un acento (principio 23; a contraste
#       alto warning y error convergian). Imprime el JSON que importan las
#       plantillas de matugen ({{status.warning.default.hex}}; C va a
#       {{theme.contrast}}, solo informativo); --write lo deja en
#       ~/.cache/matugen/status.json (import_json_files de config*.toml).
#   palette check [--palette F]... [--samples] [--code] [--templates] [--all] [--quiet]
#       PC-P pares de contraste, PC-S invariantes de estado (sobre una paleta
#       generada: el JSON de Quickshell o muestras de los wallpapers del
#       historial), PC-Q reglas del QML, PC-T tabla semantica de las plantillas,
#       PC-T5 texto de las plantillas legible en oscuro y claro (P5.5), PC-A lista
#       de literales permitidos. Sin opciones: --all (sin muestras).
#       Salida 0 limpio, 1 fallos, 2 error interno. Los AVISO no fallan.
#
# Datos (SOURCE): dotshell/data/palette.rules.json (semillas, umbrales, pares,
# tabla de plantillas) y palette.allow.json (literales justificados). Los alias
# y su rol salen de dotshell/SemanticPalette.qml (unica fuente).
# Pruebas: PALETTE_DATA, PALETTE_QML, PALETTE_TEMPLATES, PALETTE_STATUS_OUT,
# PALETTE_STATE (historial de wallpapers para --samples).
set -uo pipefail

export PALETTE_DATA=${PALETTE_DATA:-$HOME/.config/quickshell/dotshell/data}
export PALETTE_QML=${PALETTE_QML:-$HOME/.config/quickshell/dotshell}
export PALETTE_TEMPLATES=${PALETTE_TEMPLATES:-$HOME/.config/matugen/templates}
export PALETTE_STATUS_OUT=${PALETTE_STATUS_OUT:-${XDG_CACHE_HOME:-$HOME/.cache}/matugen/status.json}
export PALETTE_STATE=${PALETTE_STATE:-$HOME/.local/state/dotfiles/wallpapers.json}
export PALETTE_TMP=${XDG_RUNTIME_DIR:-/tmp}/dotfiles-palette
PALETTE_BIN=$(dirname "$(readlink -f "$0")")
export PALETTE_BIN
mkdir -p "$PALETTE_TMP"

python3 - "$@" <<'PY'
import glob, json, math, os, re, subprocess, sys

DATA = os.environ["PALETTE_DATA"]; QML = os.environ["PALETTE_QML"]; TEMPLATES = os.environ["PALETTE_TEMPLATES"]
STATUS_OUT = os.environ["PALETTE_STATUS_OUT"]; STATE = os.environ["PALETTE_STATE"]; TMP = os.environ["PALETTE_TMP"]
STATUS_ROLES = ["error", "on_error", "error_container", "on_error_container",
                "warning", "on_warning", "warning_container", "on_warning_container",
                "success", "on_success", "success_container", "on_success_container"]


# Mensajes en el idioma del usuario (Fase 15 B4): scripts/i18n, texto fuente en ingles.
def _i18n():
    import importlib.machinery, importlib.util
    sys.dont_write_bytecode = True  # sin __pycache__ junto a los scripts
    loader = importlib.machinery.SourceFileLoader("i18n", os.path.join(os.environ["PALETTE_BIN"], "i18n"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("i18n", loader))
    loader.exec_module(mod)
    return mod
T, Tn = _i18n().translator()
def N_(ctx, text): return text
# Niveles de un hallazgo (se traducen al imprimirlos).
LEVELS = [N_("palette level", "FAIL"), N_("palette level", "NOTICE")]


def die(msg):
    print(f"palette: {msg}", file=sys.stderr)
    sys.exit(2)


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError) as e:
        die(T("couldn't read %1: %2", path, e))


RULES = load(os.path.join(DATA, "palette.rules.json"))


# ---- Color --------------------------------------------------------------------------------------
def rgb(x):
    x = x.lstrip("#")
    return [int(x[i:i + 2], 16) / 255 for i in (0, 2, 4)]


def lin(c):
    return [v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4 for v in c]


def lum(x):
    c = lin(rgb(x))
    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]


def ratio(a, b):
    A, B = sorted([lum(a), lum(b)], reverse=True)
    return (A + 0.05) / (B + 0.05)


def mix(a, b, t):  # a sobre b con opacidad t
    ca, cb = rgb(a), rgb(b)
    return "#" + "".join("%02x" % round(255 * (x * t + y * (1 - t))) for x, y in zip(ca, cb))


def oklab(c):  # c lineal
    r, g, b = c
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
            1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
            0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)


def hue(x):
    _, a, b = oklab(lin(rgb(x)))
    return math.degrees(math.atan2(b, a)) % 360


def dhue(a, b):
    d = abs(hue(a) - hue(b)) % 360
    return min(d, 360 - d)


def delta_e(ca, cb):  # sobre colores lineales, x100
    return 100 * math.dist(oklab(ca), oklab(cb))


# Machado et al. 2009, severidad 1 (RGB lineal).
CVD = {
    "deuteranopia": [[0.367322, 0.860646, -0.227968], [0.280085, 0.672501, 0.047413], [-0.011820, 0.042940, 0.968881]],
    "protanopia": [[0.152286, 1.052583, -0.204868], [0.114503, 0.786281, 0.099216], [-0.003882, -0.048116, 1.051998]],
    "tritanopia": [[1.255528, -0.076749, -0.178779], [-0.078411, 0.930809, 0.147602], [0.004733, 0.691367, 0.303900]],
}


def sim(c, m):
    return [max(0.0, min(1.0, sum(m[i][j] * c[j] for j in range(3)))) for i in range(3)]


def cvd_min(a, b):
    la, lb = lin(rgb(a)), lin(rgb(b))
    return min((delta_e(sim(la, m), sim(lb, m)), k) for k, m in CVD.items())


# ---- Estado (palette status) ----------------------------------------------------------------------
_STATUS = {}


def status_table():
    """Roles de estado en oscuro y claro: {modo: {rol: hex}} (contraste fijo)."""
    if _STATUS:
        return _STATUS
    st = RULES["status"]
    contrast = st["contrast"]
    cfg = os.path.join(TMP, "status.toml")
    body = "[config]\n[config.custom_colors]\n" + "".join(
        f'{k} = {{ color = "{v}", blend = false }}\n' for k, v in st["seeds"].items()) + "[templates]\n"
    if not os.path.exists(cfg) or open(cfg).read() != body:
        with open(cfg + ".tmp", "w") as f:
            f.write(body)
        os.replace(cfg + ".tmp", cfg)
    seed = next(iter(st["seeds"].values()))
    r = subprocess.run(["matugen", "-c", cfg, "color", "hex", seed, "-t", st["scheme"], "--contrast", str(contrast),
                        "--dry-run", "-j", "hex", "-q"], capture_output=True, text=True, stdin=subprocess.DEVNULL)
    try:
        colors = json.loads(r.stdout)["colors"]
        _STATUS.update({m: {k: colors[k][m]["color"].lower() for k in STATUS_ROLES} for m in ("dark", "light")})
        return _STATUS
    except (ValueError, KeyError):
        die(T("matugen didn't return the status family: %1", r.stderr.strip()[:200]))


def fmt(h):
    c = h.lstrip("#")
    return {"hex": "#" + c, "hex_stripped": c, "red": str(int(c[0:2], 16)), "green": str(int(c[2:4], 16)),
            "blue": str(int(c[4:6], 16))}


def cmd_status(args):
    mode, contrast, write = "dark", 0.0, False
    it = iter(args)
    for a in it:
        if a == "--mode":
            mode = next(it, "")
        elif a == "--contrast":
            try:
                contrast = float(next(it, ""))
            except ValueError:
                die(T("--contrast needs a number"))
        elif a == "--write":
            write = True
        else:
            die(T("unknown option: %1", a))
    if mode not in ("dark", "light"):
        die(T("--mode: dark or light"))
    if not -1 <= contrast <= 1:
        die(T("--contrast out of -1..1"))
    tab = status_table()
    t = tab[mode]
    # status_dark / status_light (P5.5): las dos familias, para la vista previa
    # de un tema en el otro modo (plantilla de Quickshell).
    out = {"status": {k: {"default": fmt(v)} for k, v in t.items()},
           "theme": {"mode": mode, "contrast": contrast}}
    out.update({"status_" + m: {k: {"default": fmt(v)} for k, v in tab[m].items()} for m in ("dark", "light")})
    text = json.dumps(out, separators=(",", ":"))
    if write:
        os.makedirs(os.path.dirname(STATUS_OUT), exist_ok=True)
        with open(STATUS_OUT + ".tmp", "w") as f:
            f.write(text + "\n")
        os.replace(STATUS_OUT + ".tmp", STATUS_OUT)
    else:
        print(text)


# ---- Alias (unica fuente: SemanticPalette.qml) --------------------------------------------------
M3_TO_JSON = {"m3" + k.split("_")[0] + "".join(p.capitalize() for p in k.split("_")[1:]): k for k in [
    "surface", "surface_container_lowest", "surface_container_low", "surface_container", "surface_container_high",
    "surface_container_highest", "on_surface", "on_surface_variant", "outline", "outline_variant", "primary",
    "on_primary", "primary_container", "on_primary_container", "secondary", "on_secondary", "secondary_container",
    "on_secondary_container", "tertiary", "on_tertiary", "tertiary_container", "on_tertiary_container", "error",
    "on_error", "error_container", "on_error_container", "shadow", "scrim"]}
M3_TO_JSON.update({"status" + "".join(p.capitalize() for p in k.split("_")): k for k in STATUS_ROLES})

TINT_ALIAS_RE = re.compile(r"^\s*readonly property color (\w+): root\.tint\(root\.(\w+), root\.\w+\)\s*$")
ALIAS_RE = re.compile(r"^\s*readonly property color (\w+): (?:root\.(highContrast|light) \? root\.(\w+) : )?root\.(\w+)\s*$")


def aliases():
    """alias -> (rol normal, rol alternativo, condicion) en nombres del JSON de la paleta.
    Condicion: "highContrast" (el alternativo en alto contraste) o "light" (en modo claro, P5.5)."""
    path = os.path.join(QML, RULES["qml"]["semanticFile"])
    out = {}
    for line in open(path):
        m = ALIAS_RE.match(line)
        if m and m.group(4) in M3_TO_JSON:
            alt = M3_TO_JSON.get(m.group(3)) if m.group(3) else None
            normal = M3_TO_JSON[m.group(4)]
            out[m.group(1)] = (normal, alt or normal, m.group(2) or "highContrast")
    # Un alias que es otro con transparencia (frame = tint(surfaceLow, frameOpacity), Fase 16 B2):
    # para los contrastes cuenta como su base (el piso legible de la transparencia lo cubre).
    for line in open(path):
        m = TINT_ALIAS_RE.match(line)
        if m and m.group(2) in out:
            out[m.group(1)] = out[m.group(2)]
    return out


# ---- Hallazgos ------------------------------------------------------------------------------------
class Report:
    def __init__(self, quiet):
        self.fail, self.notice, self.quiet, self.seen = 0, 0, quiet, set()

    def add(self, level, rule, where, msg):
        key = (level, rule, where, msg)
        if key in self.seen:
            return
        self.seen.add(key)
        if level == "FAIL":
            self.fail += 1
        else:
            self.notice += 1
        if not self.quiet or level == "FAIL":
            print(f"{T(level, ctx='palette level')} {rule} {where}: {msg}")


def palette_values(pal, al, hc):
    """alias -> hex para una paleta plana (claves del JSON de Quickshell)."""
    out = {}
    for a, (normal, alt, cond) in al.items():
        k = alt if (pal.get("mode") == "light" if cond == "light" else hc) else normal
        if k in pal:
            out[a] = pal[k]
    return out


def check_palette(rep, pal, label, al):
    th = RULES["thresholds"]
    mins = {"text": th["text"], "large": th["large"], "ui": th["ui"]}
    for hc in (False, True):
        v = palette_values(pal, al, hc)
        tag = label + (" +altoContraste" if hc else "")
        for p in RULES["pairs"]:
            fgs = p["fg"] if isinstance(p["fg"], list) else [p["fg"]]
            need = mins[p["min"]]
            if hc and p["min"] == "text" and p["fg"] in ("text", "textMuted"):
                need = th["highContrastText"]
            for fg in fgs:
                for bg in p["bg"]:
                    if fg not in v or bg not in v:
                        rep.add("FAIL", "PC-P0", tag, T("alias %1 is missing", fg if fg not in v else bg))
                        continue
                    r = ratio(v[fg], v[bg])
                    if r + 1e-9 < need:
                        # outline_variant/divider y contraste 0: ya decorativos; el resto falla.
                        rep.add("FAIL", "PC-P1", tag, T("%1: %2 on %3 = %4 (< %5)", p['id'], fg, bg, f"{r:.2f}", need))
        # Piso de transparencia: texto secundario sobre la superficie translucida,
        # con el peor fondo posible detras (blanco en oscuro, negro en claro).
        fl = RULES["floor"]
        dark = lum(v.get("background", "#000000")) < 0.2
        worst = "#ffffff" if dark else "#000000"
        comp = mix(v[fl["bg"]], worst, th["surfaceFloor"])
        r = ratio(v[fl["fg"]], comp)
        if r + 1e-9 < mins[fl["min"]]:
            rep.add("FAIL", "PC-P2", tag, T("transparency floor %1: %2 = %3", th['surfaceFloor'], fl['fg'], f"{r:.2f}"))
    check_status(rep, pal, label)


def check_status(rep, pal, label):
    th = RULES["thresholds"]
    for k in ("warning", "success", "error", "primary"):
        if k not in pal:
            rep.add("FAIL", "PC-S0", label, T("the palette has no %1", k))
            return
    w, s, e, acc = pal["warning"], pal["success"], pal["error"], pal["primary"]
    # S1: valores exactos de la familia fija para el modo de la paleta.
    mode = pal.get("mode")
    if mode in ("dark", "light"):
        ref = status_table()[mode]
        for k in STATUS_ROLES:
            if pal.get(k, "").lower() != ref[k]:
                rep.add("FAIL", "PC-S1", label, T("%1 = %2 (the system fixes %3 in %4)", k, pal.get(k), ref[k], mode))
    else:
        rep.add("NOTICE", "PC-S1", label, T("no mode: not compared with the fixed family"))
    # S2: familias de tono.
    for k, rng in (("error", th["dangerHue"]), ("warning", th["warningHue"]), ("success", th["successHue"])):
        h = hue(pal[k])
        if not rng[0] <= h <= rng[1]:
            rep.add("FAIL", "PC-S2", label, T("%1 outside its family: hue %2 (expected %3-%4)", k, f"{h:.0f}", rng[0], rng[1]))
    # S3: separacion warning/error y success/otros.
    if dhue(w, e) < th["warningDangerHue"]:
        rep.add("FAIL", "PC-S3", label, T("warning and error %1 degrees apart (< %2)", f"{dhue(w, e):.0f}", th['warningDangerHue']))
    de = delta_e(lin(rgb(w)), lin(rgb(e)))
    if de < th["warningDangerDeltaE"]:
        rep.add("FAIL", "PC-S3", label, T("warning and error: dE %1 (< %2)", f"{de:.1f}", th['warningDangerDeltaE']))
    for a, b in (("success", "error"), ("success", "warning")):
        if dhue(pal[a], pal[b]) < th["statusHue"]:
            rep.add("FAIL", "PC-S3", label, T("%1 and %2 %3 degrees apart", a, b, f"{dhue(pal[a], pal[b]):.0f}"))
    c, kind = cvd_min(w, e)
    if c < th["cvdDeltaE"]:
        rep.add("FAIL", "PC-S4", label, T("warning/error indistinguishable with %1: dE %2", kind, f"{c:.1f}"))
    # S5: el acento del wallpaper coincide con un estado (identidad y significado
    # no se confunden por la forma: C4). Solo aviso.
    for k in ("warning", "success", "error"):
        d = delta_e(lin(rgb(acc)), lin(rgb(pal[k])))
        if d < th["accentNoticeDeltaE"]:
            rep.add("NOTICE", "PC-S5", label, T("the wallpaper accent matches %1 (dE %2); the status is told apart by icon/text", k, f"{d:.1f}"))


def samples():
    """Paletas de los wallpapers del historial: esquema/contraste efectivos y extremos."""
    try:
        st = json.load(open(STATE))
    except (OSError, ValueError):
        return []
    wps = []
    for h in st.get("history", []):
        wp = h.get("wallpaper")
        if wp and wp not in wps and os.path.exists(wp):
            wps.append(wp)
    wps = wps[:12]
    # El esquema que eligio el usuario (appearance.scheme); PALETTE_SCHEME en pruebas.
    scheme = os.environ.get("PALETTE_SCHEME") or subprocess.run(
        [os.path.join(os.environ["PALETTE_BIN"], "settings"), "get", "appearance.scheme"],
        capture_output=True, text=True).stdout.strip() or "scheme-content"
    cfg = os.path.join(TMP, "empty.toml")
    if not os.path.exists(cfg):
        open(cfg, "w").write("[config]\n[templates]\n")
    out = []
    stt = status_table()
    for contrast in (0.0, 0.33, 0.66, 1.0):
        for wp in wps:
            r = subprocess.run(["matugen", "-c", cfg, "image", wp, "-t", scheme, "--contrast", str(contrast), "-r",
                                "gaussian", "--prefer", "saturation", "--dry-run", "-j", "hex", "-q"],
                               capture_output=True, text=True, stdin=subprocess.DEVNULL)
            try:
                colors = json.loads(r.stdout)["colors"]
            except (ValueError, KeyError):
                continue
            for mode in ("dark", "light"):
                pal = {k: v[mode]["color"].lower() for k, v in colors.items()}
                pal.update(stt[mode])
                pal.update({"mode": mode, "contrast": contrast})
                out.append((f"{os.path.basename(wp)}/{scheme}/{mode}/c{contrast:g}", pal))
    return out


# ---- QML ------------------------------------------------------------------------------------------
NAMED = ("white|black|red|green|blue|yellow|orange|purple|violet|gray|grey|pink|cyan|magenta|brown|lime|navy|"
         "teal|silver|gold|maroon|olive|aqua|fuchsia|indigo|crimson|coral|salmon|khaki|beige|ivory|lavender")
LITERAL_RE = re.compile(r'"#[0-9a-fA-F]{3,8}"|\bQt\.(rgba|hsla|hsva|lighter|darker|tint)\s*\(|"(?:' + NAMED + r')"')
COLORS_RE = re.compile(r"\bColors\.(\w+)")


def allow():
    return load(os.path.join(DATA, "palette.allow.json")).get("literals", [])


def qml_files():
    # Toda la carpeta (modules/, lock/, login/, settings/…): una superficie nueva
    # entra sola al control (Fase 10 B1; antes solo la raiz y modules/).
    fs = sorted(glob.glob(os.path.join(QML, "**", "*.qml"), recursive=True))
    return [f for f in fs if os.path.basename(f) not in ("probe_shell.qml",)]


def check_code(rep):
    q = RULES["qml"]
    al = aliases()
    known = set(al) | {"tint", "reload", "ready", "image", "textDisabled", "highContrast", "disabledOpacity", "mode", "light",
                       "familyOf"}
    ident = set(q["identity"])
    state_re = re.compile(q["stateWords"], re.I)
    allowed = allow()
    used = {i: 0 for i in range(len(allowed))}
    for f in qml_files():
        rel = os.path.relpath(f, QML)
        base = os.path.basename(f)
        for n, line in enumerate(open(f), 1):
            code = line.split("//", 1)[0] if not line.lstrip().startswith("//") else ""
            if not code.strip():
                continue
            where = f"{rel}:{n}"
            # Q1 literales (salvo los permitidos).
            if LITERAL_RE.search(code):
                hit = [i for i, a in enumerate(allowed) if a["file"] == rel and a["anchor"] in line]
                if hit:
                    for i in hit:
                        used[i] += 1
                elif base != q["semanticFile"] and base != "Colors.qml":
                    rep.add("FAIL", "PC-Q1", where, T("literal color outside the architecture: %1", code.strip()[:90]))
            # Q2 roles crudos.
            if base not in q["m3Allowed"] and re.search(r"\bColors\.(m3|status)\w+", code):
                rep.add("FAIL", "PC-Q2", where, T("direct palette role (use a SemanticPalette alias)"))
            # Q3 alfa a mano: Qt.alpha fuera de la paleta, o tint sin un valor de Tokens.
            if base not in q["alphaAllowed"] and "Qt.alpha(" in code:
                hit = [i for i, a in enumerate(allowed) if a["file"] == rel and a["anchor"] in line]
                if hit:
                    for i in hit:
                        used[i] += 1
                else:
                    rep.add("FAIL", "PC-Q3", where, T("Qt.alpha by hand (use Colors.tint with a token)"))
            for m in re.finditer(r"Colors\.tint\(([^;]*)", code):
                args = m.group(1)
                if "Tokens." not in args:
                    rep.add("FAIL", "PC-Q3", where, T("Colors.tint without a Tokens value"))
            # Q4 un color de identidad elegido por un estado (principio 23): la
            # condicion de un ?: o de un if/return nombra un estado y el color
            # que elige cuando se cumple es de identidad.
            names = COLORS_RE.findall(code)
            picks = [(m.group(1), m.group(2)) for m in re.finditer(r"([^?:]+)\?\s*Colors\.(\w+)", code)]
            picks += [(m.group(1), m.group(2)) for m in re.finditer(r"if\s*\(([^)]*)\)\s*return\s+Colors\.(\w+)", code)]
            if any(x in ident and state_re.search(COLORS_RE.sub("", cond)) for cond, x in picks):
                hit = [i for i, a in enumerate(allowed) if a["file"] == rel and a["anchor"] in line and a.get("rule") == "PC-Q4"]
                if hit:
                    for i in hit:
                        used[i] += 1
                else:
                    rep.add("FAIL", "PC-Q4", where, T("a status picks an identity color: %1", code.strip()[:90]))
            # Q5 paletas locales (LocalPalette, MediaColors de P12.5, AppColors de P5.6) solo donde la
            # arquitectura lo permite (P8.7 §3.4); el productor no cuenta.
            if re.search(r"\b(LocalPalette|MediaColors|AppColors)\b", code) and rel not in q["localAccentConsumers"] and base not in ("MediaColors.qml", "AppColors.qml"):
                rep.add("FAIL", "PC-Q5", where, T("local palette outside the allowed elements"))
            # Q6 alias inexistente.
            if base not in q["m3Allowed"]:
                for x in names:
                    if x not in known and not x.startswith(("m3", "status")):
                        rep.add("FAIL", "PC-Q6", where, T("Colors.%1 doesn't exist in SemanticPalette", x))
    # PC-A permitidos vencidos.
    for i, a in enumerate(allowed):
        if not used[i]:
            rep.add("FAIL", "PC-A1", a["file"], T("allowed literal that no longer exists: %1", repr(a['anchor'])))


# ---- Plantillas -------------------------------------------------------------------------------------
TPL_LITERAL = re.compile(r"(?<![{\w])#[0-9a-fA-F]{6}\b")


def check_templates(rep):
    rows = RULES["templates"]
    by_file = {}
    for r in rows:
        by_file.setdefault(r["file"], []).append(r)
    for f, rs in by_file.items():
        path = os.path.join(TEMPLATES, f)
        try:
            lines = open(path).read().splitlines()
        except OSError:
            rep.add("FAIL", "PC-T0", f, T("template not found"))
            continue
        for r in rs:
            roles = r["role"] if isinstance(r["role"], list) else [r["role"]]
            hits = [(n, l) for n, l in enumerate(lines, 1) if re.search(r["line"], l)]
            if not hits:
                rep.add("FAIL", "PC-T1", f, T("no line for %1", r['line']))
            for n, l in hits:
                refs = re.findall(r"\{\{\s*((?:colors|status)\.\w+)", l)
                if not refs or any(x not in roles for x in refs):
                    rep.add("FAIL", "PC-T2", f"{f}:{n}", T("expected %1: %2", T(" or ").join(roles), l.strip()[:80]))
    # T4: el error sale de palette status, nunca de la paleta del esquema.
    err_re = re.compile(r"\{\{\s*colors\.(on_)?error(_container)?\.")
    for path in sorted(glob.glob(os.path.join(TEMPLATES, "**", "*"), recursive=True)):
        if os.path.isdir(path):
            continue
        for n, l in enumerate(open(path, errors="replace").read().splitlines(), 1):
            if err_re.search(l):
                rep.add("FAIL", "PC-T4", f"{os.path.relpath(path, TEMPLATES)}:{n}", T("colors.error* (use status.error*)"))
    for path in sorted(glob.glob(os.path.join(TEMPLATES, "**", "*"), recursive=True)):
        if os.path.isdir(path):
            continue
        rel = os.path.relpath(path, TEMPLATES)
        try:
            text = open(path, errors="replace").read()
        except OSError:
            continue
        for n, l in enumerate(text.splitlines(), 1):
            if TPL_LITERAL.search(re.sub(r"\{\{.*?\}\}", "", l)) and not l.lstrip().startswith(("#", "//", "--", "/*", "*")):
                rep.add("FAIL", "PC-T3", f"{rel}:{n}", T("literal color in a template: %1", l.strip()[:80]))



# T5 (P5.5): el texto de las plantillas se lee en oscuro Y en claro. Paletas de
# semillas fijas (templateText.seeds) en todos los esquemas, sin wallpapers:
# corre sin historial y da lo mismo en cualquier maquina.
_TEXT_PALS = []


def text_palettes():
    if _TEXT_PALS:
        return _TEXT_PALS
    tt = RULES["templateText"]
    cfg = os.path.join(TMP, "empty.toml")
    if not os.path.exists(cfg):
        open(cfg, "w").write("[config]\n[templates]\n")
    stt = status_table()
    for seed in tt["seeds"]:
        for scheme in tt["schemes"]:
            r = subprocess.run(["matugen", "-c", cfg, "color", "hex", seed, "-t", scheme, "--contrast", "0",
                                "--dry-run", "-j", "hex", "-q"], capture_output=True, text=True, stdin=subprocess.DEVNULL)
            try:
                colors = json.loads(r.stdout)["colors"]
            except (ValueError, KeyError):
                die(T("matugen didn't return the palette of %1: %2", seed, r.stderr.strip()[:200]))
            for mode in ("dark", "light"):
                pal = {"colors." + k: v[mode]["color"].lower() for k, v in colors.items()}
                pal.update({"status." + k: v for k, v in stt[mode].items()})
                _TEXT_PALS.append((f"{seed}/{scheme}/{mode}", pal))
    return _TEXT_PALS


REF_RE = re.compile(r"\{\{\s*((?:colors|status)\.\w+)")
PAIR_RE = re.compile(r"\b(fg|bg)\s*=\s*\"#?\{\{\s*((?:colors|status)\.\w+)")
NEXT_BG_RE = re.compile(r"\"background_color\":\s*\"\{\{\s*((?:colors|status)\.\w+)")


def check_template_text(rep):
    tt = RULES["templateText"]
    th = RULES["thresholds"]
    pals = text_palettes()
    for row in tt["rows"]:
        f = row["file"]
        try:
            lines = open(os.path.join(TEMPLATES, f)).read().splitlines()
        except OSError:
            rep.add("FAIL", "PC-T0", f, T("template not found"))
            continue
        hits = [(n, l) for n, l in enumerate(lines, 1) if re.search(row["line"], l)]
        if not hits:
            rep.add("FAIL", "PC-T5", f, T("no line for %1", row['line']))
        for n, l in hits:
            pairs = dict((k, v) for k, v in PAIR_RE.findall(l))
            if pairs:  # fg y bg en la misma linea (yazi): fg sobre ese bg
                fg = pairs.get("fg")
                bgs = [pairs["bg"]] if "bg" in pairs else row["bg"]
                if not fg or fg in bgs:
                    continue  # marcadores llenos (fg = bg)
                fgs = [fg]
            else:
                # Un fondo propio en la linea siguiente (glow: background_color).
                nb = NEXT_BG_RE.search(lines[n]) if n < len(lines) else None
                fgs = REF_RE.findall(l)
                bgs = [nb.group(1)] if nb else row["bg"]
            for fg in fgs:
                # Texto atenuado (outline: comentarios, separadores) pide 3:1, como Material.
                need = th[tt["dimRoles"].get(fg, row.get("min", "text"))]
                b = bgs
                worst = None
                for label, pal in pals:
                    if fg not in pal or any(x not in pal for x in b):
                        rep.add("FAIL", "PC-T5", f"{f}:{n}", T("unknown role: %1 on %2", fg, b))
                        break
                    for x in b:
                        r = ratio(pal[fg], pal[x])
                        if worst is None or r < worst[0]:
                            worst = (r, label, x)
                if worst and worst[0] < need:
                    rep.add("FAIL", "PC-T5", f"{f}:{n}",
                            T("%1 on %2 = %3 (< %4) in %5: %6", fg, worst[2], f"{worst[0]:.2f}", need, worst[1], l.strip()[:60]))

# ---- Entrada --------------------------------------------------------------------------------------
def cmd_check(args):
    pals, do_samples, do_code, do_tpl, quiet = [], False, False, False, False
    it = iter(args)
    for a in it:
        if a == "--palette":
            pals.append(next(it, ""))
        elif a == "--samples":
            do_samples = True
        elif a == "--code":
            do_code = True
        elif a == "--templates":
            do_tpl = True
        elif a == "--all":
            do_code = do_tpl = True
        elif a == "--quiet":
            quiet = True
        else:
            die(T("unknown option: %1", a))
    if not (pals or do_samples or do_code or do_tpl):
        do_code = do_tpl = True
    rep = Report(quiet)
    al = aliases()
    if not al:
        die(T("no aliases found in SemanticPalette.qml"))
    for p in pals:
        check_palette(rep, load(p), os.path.basename(p), al)
    n = 0
    if do_samples:
        for label, pal in samples():
            check_palette(rep, pal, label, al)
            n += 1
    if do_code:
        check_code(rep)
    if do_tpl:
        check_templates(rep)
        check_template_text(rep)
    extra = T(" · %1 samples", n) if do_samples else ""
    print(T("palette check: %1 failures · %2 notices", rep.fail, rep.notice) + extra)
    sys.exit(1 if rep.fail else 0)


cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd == "status":
    cmd_status(sys.argv[2:])
elif cmd == "check":
    cmd_check(sys.argv[2:])
else:
    die(T("usage: %1", "palette status [--mode M] [--contrast C] [--write] | palette check [--palette F] [--samples] [--code] [--templates] [--all] [--quiet]"))
