#!/usr/bin/env bash
# Capturas de pantalla: full | region | window (Fase 4 B8).
#   full    el monitor enfocado
#   region  pantalla congelada mientras se elige (como hyprshot --freeze), con
#           las ventanas como destinos (capture-select)
#   window  la ventana activa
# Guarda en ~/Pictures/Screenshots, copia la imagen al portapapeles y se la
# pasa a Quickshell (vista previa: anotar con satty, copiar, abrir, carpeta,
# papelera). Sin la shell, la captura igual queda guardada y copiada.
# Requiere: grim, slurp, hyprpicker, wl-clipboard, jq
set -euo pipefail

# Carpeta: capture.screenshotsDir (settings store, Fase 8 B1).
DIR=$("$(dirname "$0")/settings" get capture.screenshotsDir) || exit 1
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"
MODE="${1:-region}"

# Congelar la pantalla mientras se elige (hyprpicker sin lupa); grim captura
# esa imagen congelada, asi menus y tooltips quedan como estaban.
FREEZE=""
unfreeze() { if [[ -n $FREEZE ]]; then kill "$FREEZE" 2>/dev/null || true; FREEZE=""; fi; }
trap unfreeze EXIT

# -l 1: compresion minima del PNG (pantalla completa 317 ms contra 858 ms,
# +9 % de tamano).
EXTRA=""
case "$MODE" in
    full)
        read -r MON GEOM < <(hyprctl -j monitors | jq -r '.[] | select(.focused) | "\(.name) \(.x),\(.y) \((.width / .scale) | floor)x\((.height / .scale) | floor)"')
        grim -l 1 -o "$MON" "$FILE"
        EXTRA="$MON"
        ;;
    window)
        IFS=$'\t' read -r GEOM EXTRA < <(hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])\t\(.class)"')
        [[ $GEOM == *null* ]] && exit 0 # sin ventana activa
        grim -l 1 -g "$GEOM" "$FILE"
        ;;
    region)
        hyprpicker -r -z >/dev/null 2>&1 &
        FREEZE=$!
        sleep 0.1
        GEOM=$("$(dirname "$0")/capture-select") || exit 0 # cancelado (Esc)
        grim -l 1 -g "$GEOM" "$FILE"
        unfreeze
        ;;
    *)
        echo "uso: screenshot full|region|window" >&2
        exit 2
        ;;
esac

wl-copy -t image/png < "$FILE"
qs -c dotshell ipc call capture preview "$FILE" "$MODE" "$GEOM" "$(stat -c %s "$FILE")" "$EXTRA" >/dev/null 2>&1 || true
