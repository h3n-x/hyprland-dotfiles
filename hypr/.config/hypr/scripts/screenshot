#!/usr/bin/env bash
# Capturas de pantalla: full | region | window
# Las 3 copian directo al portapapeles (wl-copy), sin pasar por un editor --
# si queres anotar (flechas/blur/texto) antes de copiar, satty sigue
# instalado y configurado (ver matugen/.config/matugen/templates/satty.toml):
# corre `satty --filename <captura> --output-filename <captura> --copy-to-clipboard`
# a mano sobre el archivo ya guardado en ~/Pictures/Screenshots.
# Requiere: grim, slurp, wl-clipboard, libnotify
set -euo pipefail

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"
MODE="${1:-region}"

notify() { notify-send -a Screenshot -i "$FILE" "$@"; }

case "$MODE" in
  full)
    grim "$FILE"
    wl-copy < "$FILE"
    notify "Captura completa" "Guardada y copiada al portapapeles"
    ;;
  window)
    ACTIVE_BOX=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    grim -g "$ACTIVE_BOX" "$FILE"
    wl-copy < "$FILE"
    notify "Captura de ventana" "Guardada y copiada al portapapeles"
    ;;
  region|*)
    GEOM=$(slurp -d) || exit 0 # cancelado por el usuario
    grim -g "$GEOM" "$FILE"
    wl-copy < "$FILE"
    notify "Captura de region" "Guardada y copiada al portapapeles"
    ;;
esac
