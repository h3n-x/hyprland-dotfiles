
# Archivos de color generados por matugen (regenerables con
# `matugen image <wallpaper>`, ver matugen/.config/matugen/) -- no se commitean.
quickshell/.config/quickshell/dotshell/Colors.qml
btop/.config/btop/themes/matugen.theme
yazi/.config/yazi/flavors/matugen.yazi/flavor.toml
nvim/.config/nvim/lua/matugen_colors.lua
kitty/.config/kitty/colors.conf
rofi/.config/rofi/colors.rasi
hypr/.config/hypr/colors.conf
hypr/.config/hypr/current-wallpaper.conf
hypr/.config/hypr/modules/colors.lua
gtk-3.0/.config/gtk-3.0/gtk.css
gtk-4.0/.config/gtk-4.0/gtk.css
# fzf-opts.sh y icon-color viven en ~/.cache/matugen/, fuera del repo, no
# hace falta ignorarlos aca.
qt5ct/.config/qt5ct/colors/matugen.conf
qt6ct/.config/qt6ct/colors/matugen.conf
spicetify/.config/spicetify/Themes/matugen/color.ini
