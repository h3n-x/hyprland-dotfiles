{
  "version": 1,
  "status": {
    "scheme": "scheme-fidelity",
    "contrast": 0.33,
    "seeds": {
      "warning": "#F0B429",
      "success": "#3FA06A"
    },
    "note": "danger = error de M3 (igual en todos los esquemas); toda la familia se fija en este contraste: solo cambia con el modo"
  },
  "thresholds": {
    "text": 4.5,
    "large": 3.0,
    "ui": 3.0,
    "highContrastText": 7.0,
    "surfaceFloor": 0.85,
    "warningDangerHue": 40,
    "warningDangerDeltaE": 8,
    "statusHue": 40,
    "cvdDeltaE": 2.5,
    "accentNoticeDeltaE": 3,
    "dangerHue": [
      15,
      40
    ],
    "warningHue": [
      60,
      100
    ],
    "successHue": [
      130,
      170
    ]
  },
  "pairs": [
    {
      "id": "text",
      "fg": "text",
      "bg": [
        "background",
        "surfaceLowest",
        "surfaceLow",
        "surface",
        "surfaceHigh",
        "surfaceHighest"
      ],
      "min": "text"
    },
    {
      "id": "textMuted",
      "fg": "textMuted",
      "bg": [
        "background",
        "surfaceLowest",
        "surfaceLow",
        "surface",
        "surfaceHigh",
        "surfaceHighest"
      ],
      "min": "text"
    },
    {
      "id": "accent",
      "fg": "textOnAccent",
      "bg": [
        "accent"
      ],
      "min": "text"
    },
    {
      "id": "accentContainer",
      "fg": "textOnAccentContainer",
      "bg": [
        "accentContainer"
      ],
      "min": "text"
    },
    {
      "id": "accentAlt",
      "fg": "textOnAccentAlt",
      "bg": [
        "accentAlt"
      ],
      "min": "text"
    },
    {
      "id": "accentAltContainer",
      "fg": "textOnAccentAltContainer",
      "bg": [
        "accentAltContainer"
      ],
      "min": "text"
    },
    {
      "id": "decor",
      "fg": "textOnDecor",
      "bg": [
        "decor"
      ],
      "min": "text"
    },
    {
      "id": "decorContainer",
      "fg": "textOnDecorContainer",
      "bg": [
        "decorContainer"
      ],
      "min": "text"
    },
    {
      "id": "danger",
      "fg": "textOnDanger",
      "bg": [
        "danger"
      ],
      "min": "text"
    },
    {
      "id": "dangerContainer",
      "fg": "textOnDangerContainer",
      "bg": [
        "dangerContainer"
      ],
      "min": "text"
    },
    {
      "id": "warning",
      "fg": "textOnWarning",
      "bg": [
        "warning"
      ],
      "min": "text"
    },
    {
      "id": "warningContainer",
      "fg": "textOnWarningContainer",
      "bg": [
        "warningContainer"
      ],
      "min": "text"
    },
    {
      "id": "success",
      "fg": "textOnSuccess",
      "bg": [
        "success"
      ],
      "min": "text"
    },
    {
      "id": "successContainer",
      "fg": "textOnSuccessContainer",
      "bg": [
        "successContainer"
      ],
      "min": "text"
    },
    {
      "id": "accentText",
      "fg": "accent",
      "bg": [
        "surface",
        "surfaceHigh"
      ],
      "min": "large"
    },
    {
      "id": "statusIcons",
      "fg": [
        "danger",
        "warning",
        "success"
      ],
      "bg": [
        "surface",
        "surfaceHigh",
        "surfaceHighest"
      ],
      "min": "ui"
    },
    {
      "id": "focusRing",
      "fg": "accent",
      "bg": [
        "surface",
        "surfaceHigh",
        "surfaceHighest"
      ],
      "min": "ui"
    },
    {
      "id": "border",
      "fg": "border",
      "bg": [
        "surface",
        "surfaceHigh"
      ],
      "min": "ui"
    }
  ],
  "floor": {
    "fg": "textMuted",
    "bg": "surfaceHigh",
    "min": "text"
  },
  "qml": {
    "semanticFile": "SemanticPalette.qml",
    "m3Allowed": [
      "SemanticPalette.qml",
      "Colors.qml"
    ],
    "alphaAllowed": [
      "SemanticPalette.qml"
    ],
    "identity": [
      "accent",
      "textOnAccent",
      "accentContainer",
      "textOnAccentContainer",
      "accentAlt",
      "textOnAccentAlt",
      "accentAltContainer",
      "textOnAccentAltContainer",
      "decor",
      "textOnDecor",
      "decorContainer",
      "textOnDecorContainer"
    ],
    "meaning": [
      "danger",
      "textOnDanger",
      "dangerContainer",
      "textOnDangerContainer",
      "warning",
      "textOnWarning",
      "warningContainer",
      "textOnWarningContainer",
      "success",
      "textOnSuccess",
      "successContainer",
      "textOnSuccessContainer"
    ],
    "stateWords": "warn|crit|critical|low|error|fail|failed|urgent|stale|danger|healthy|success|severity|sev\\b",
    "localAccentConsumers": ["modules/MediaProgress.qml", "modules/MediaControls.qml", "modules/CoverBars.qml", "modules/MusicTab.qml", "modules/MediaCard.qml", "modules/Switcher.qml", "modules/WorkspaceThumb.qml", "modules/Workspaces.qml", "modules/NotificationToast.qml", "modules/Launcher.qml"]
  },
  "templates": [
    {
      "file": "kitty.conf",
      "line": "^color1\\s",
      "role": "status.error"
    },
    {
      "file": "kitty.conf",
      "line": "^color9\\s",
      "role": "status.error"
    },
    {
      "file": "kitty.conf",
      "line": "^color2\\s",
      "role": "status.success"
    },
    {
      "file": "kitty.conf",
      "line": "^color10\\s",
      "role": "status.success"
    },
    {
      "file": "kitty.conf",
      "line": "^color3\\s",
      "role": "status.warning"
    },
    {
      "file": "kitty.conf",
      "line": "^color11\\s",
      "role": "status.warning"
    },
    {
      "file": "zellij-config.kdl",
      "line": "^\\s*red\\s",
      "role": "status.error"
    },
    {
      "file": "zellij-config.kdl",
      "line": "^\\s*green\\s",
      "role": "status.success"
    },
    {
      "file": "zellij-config.kdl",
      "line": "^\\s*yellow\\s",
      "role": "status.warning"
    },
    {
      "file": "zellij-config.kdl",
      "line": "^\\s*orange\\s",
      "role": "status.warning"
    },
    {
      "file": "nvim-colors.lua",
      "line": "^\\s*error\\s*=",
      "role": "status.error"
    },
    {
      "file": "btop.theme",
      "line": "\\[(cpu|free|cached|available|used|download|upload)_(start|end)\\]",
      "role": [
        "status.success",
        "status.error"
      ]
    },
    {
      "file": "btop.theme",
      "line": "\\[(cpu|free|cached|available|used|download|upload)_mid\\]",
      "role": "status.warning"
    },
    {
      "file": "nvim-colors.lua",
      "line": "^\\s*warning\\s*=",
      "role": "status.warning"
    },
    {
      "file": "nvim-colors.lua",
      "line": "^\\s*success\\s*=",
      "role": "status.success"
    },
    {
      "file": "netbeans-theme.bundle",
      "line": "name=\"added\"",
      "role": "status.success"
    },
    {
      "file": "netbeans-theme.bundle",
      "line": "name=\"removed\"",
      "role": "status.error"
    },
    {
      "file": "netbeans-theme.bundle",
      "line": "name=\"error\" waveUnderlined",
      "role": "status.error"
    },
    {
      "file": "starship.toml",
      "line": "^success_symbol",
      "role": "status.success"
    },
    {
      "file": "starship.toml",
      "line": "^error_symbol",
      "role": "status.error"
    },
    {
      "file": "yazi-flavor.toml",
      "line": "^title_warn",
      "role": "status.warning"
    },
    {
      "file": "yazi-flavor.toml",
      "line": "^title_error",
      "role": "status.error"
    },
    {
      "file": "spicetify-color.ini",
      "line": "^green\\s",
      "role": "status.success"
    },
    {
      "file": "spicetify-color.ini",
      "line": "^yellow\\s",
      "role": "status.warning"
    },
    {
      "file": "spicetify-color.ini",
      "line": "^red\\s",
      "role": "status.error"
    },
    {
      "file": "spicetify-color.ini",
      "line": "^notification-error",
      "role": "status.error"
    }
  ],
  "templateText": {
    "note": "PC-T5 (P5.5): cada linea de texto de una plantilla, en oscuro y claro, sobre su fondo (el de la fila; el de la misma linea si trae fg y bg; el background_color de la linea siguiente). min = umbral de thresholds (text 4.5, large 3, ui 3); dimRoles: roles de texto atenuado con su propio umbral",
    "seeds": ["#c0392b", "#e67e22", "#f1c40f", "#27ae60", "#16a085", "#2980b9", "#8e44ad", "#e84393", "#808080"],
    "schemes": ["scheme-content", "scheme-tonal-spot", "scheme-vibrant", "scheme-expressive", "scheme-fidelity", "scheme-neutral", "scheme-monochrome", "scheme-rainbow", "scheme-fruit-salad"],
    "dimRoles": {"colors.outline": "large"},
    "rows": [
      {"file": "kitty.conf", "line": "^(foreground|url_color|color([1-79]|1[0-5]))\\s", "bg": ["colors.surface"]},
      {"file": "kitty.conf", "line": "^color8\\s", "bg": ["colors.surface"], "min": "large"},
      {"file": "kitty.conf", "line": "^cursor\\s", "bg": ["colors.surface"], "min": "ui"},
      {"file": "kitty.conf", "line": "^selection_foreground\\s", "bg": ["colors.primary_container"]},
      {"file": "kitty.conf", "line": "^active_tab_foreground\\s", "bg": ["colors.primary"]},
      {"file": "kitty.conf", "line": "^cursor_text_color\\s", "bg": ["colors.primary"]},
      {"file": "kitty.conf", "line": "^inactive_tab_foreground\\s", "bg": ["colors.surface_container"]},
      {"file": "nvim-colors.lua", "line": "base0([4-689A-F])\\s*=", "bg": ["colors.surface", "colors.surface_container_low"]},
      {"file": "nvim-colors.lua", "line": "base03\\s*=", "bg": ["colors.surface"], "min": "large"},
      {"file": "zellij-config.kdl", "line": "^\\s*(fg|red|green|yellow|blue|magenta|orange|cyan|white)\\s", "bg": ["colors.surface"]},
      {"file": "starship.toml", "line": "fg:#", "bg": ["colors.surface"]},
      {"file": "yazi-flavor.toml", "line": "\\bfg\\s*=", "bg": ["colors.surface", "colors.surface_container"]},
      {"file": "glow-style.json", "line": "\\\"color\\\":", "bg": ["colors.surface", "colors.surface_container", "colors.surface_container_high"]},
      {"file": "spicetify-color.ini", "line": "^(text|subtext|button|button-active|selected-row)\\s", "bg": ["colors.surface", "colors.surface_container"]},
      {"file": "spicetify-color.ini", "line": "^(rosewater|flamingo|pink|maroon|red|peach|yellow|green|teal|sapphire|blue|sky|mauve|lavender)\\s", "bg": ["colors.surface", "colors.surface_container"], "min": "large"},
      {"file": "cava.conf", "line": "^gradient_color_", "bg": ["colors.surface"], "min": "ui"},
      {"file": "btop.theme", "line": "\\[(main_fg|title|hi_fg|graph_text|proc_misc)\\]", "bg": ["colors.surface"]},
      {"file": "btop.theme", "line": "\\[selected_fg\\]", "bg": ["colors.primary_container"]},
      {"file": "btop.theme", "line": "\\[(inactive_fg|process_(start|mid|end)|(cpu|free|cached|available|used|download|upload)_(start|mid|end))\\]", "bg": ["colors.surface"], "min": "large"},
      {"file": "fzf.sh", "line": "colors\\.", "bg": ["colors.surface"]}
    ]
  }
}
