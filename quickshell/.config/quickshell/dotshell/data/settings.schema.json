      "label": "Carpeta de capturas", "apply": "next-use"
    },
    "capture.recordingsDir": {
      "type": "path", "kind": "dir", "default": "~/Videos/Recordings",
      "category": "capture", "section": "Carpetas", "order": 30,
      "label": "Carpeta de grabaciones", "apply": "next-use"
    },
    "capture.recordingQuality": {
      "type": "enum", "default": "balanced",
      "values": { "high": "Alta (archivos más grandes)", "balanced": "Equilibrada", "small": "Archivos pequeños" },
      "category": "capture", "section": "Grabación", "order": 40,
      "label": "Calidad de grabación",
      "description": "Con la codificación por hardware: alta = qp 20, equilibrada = qp 24, pequeños = qp 28.",
      "apply": "next-use"
    },
    "notifications.defaultSeconds": {
      "type": "int", "default": 5, "min": 2, "max": 30, "unit": "s",
      "category": "notifications", "section": "Avisos", "order": 10,
      "label": "Duración de los avisos",
      "description": "Para las notificaciones que no indican su propia duración.",
      "apply": "live"
    },
    "notifications.fullscreen": {
      "type": "enum", "default": "critical",
      "values": { "critical": "Solo las críticas", "show": "Todas", "hide": "Ninguna" },
      "category": "notifications", "section": "Avisos", "order": 20,
      "label": "Avisos en pantalla completa y al compartir la pantalla",
      "description": "Los que no se muestran quedan en el historial y al salir aparece un resumen. Los avisos de batería siempre se muestran.",
      "keywords": ["juegos", "video", "transmisión", "grabación", "no molestar"], "apply": "live"
    },
    "system.battery.warnPct": {
      "type": "int", "default": 20, "min": 5, "max": 50, "unit": "%",
