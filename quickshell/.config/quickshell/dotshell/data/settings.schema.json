{
  "version": 1,
  "categories": {
    "appearance":    { "label": "Apariencia",       "icon": "palette",           "order": 10 },
    "accessibility": { "label": "Accesibilidad",    "icon": "accessibility",     "order": 20 },
    "bar":           { "label": "Barra",            "icon": "toolbar",           "order": 30 },
    "dashboard":     { "label": "Dashboard",        "icon": "dashboard",         "order": 40 },
    "capture":       { "label": "Capturas",         "icon": "screenshot_region", "order": 50 },
    "media":         { "label": "Multimedia",       "icon": "music_note",        "order": 60 },
    "notifications": { "label": "Notificaciones",   "icon": "notifications",     "order": 70 },
    "system":        { "label": "Sistema",          "icon": "settings",          "order": 80 },
