    "lock":          { "label": "Bloqueo e inicio", "icon": "lock",              "order": 90 },
    "keybinds":      { "label": "Atajos",           "icon": "keyboard",          "order": 100 }
  },
  "keys": {
    "appearance.osdSeconds": {
      "type": "number", "default": 1.5, "min": 0.5, "max": 10, "step": 0.5, "unit": "s",
      "category": "appearance", "section": "Indicadores", "order": 100,
      "label": "Duración del indicador de volumen y brillo",
      "keywords": ["osd", "volumen", "brillo"], "apply": "live"
    },
    "appearance.scheme": {
      "type": "enum", "default": "scheme-content",
      "values": { "scheme-content": "Contenido", "scheme-tonal-spot": "Tonal", "scheme-vibrant": "Vibrante",
                  "scheme-expressive": "Expresivo", "scheme-fidelity": "Fidelidad", "scheme-neutral": "Neutro",
                  "scheme-monochrome": "Monocromo", "scheme-rainbow": "Arcoíris", "scheme-fruit-salad": "Macedonia" },
      "category": "appearance", "section": "Color", "order": 20,
      "label": "Esquema de color de todos los wallpapers",
      "description": "Cómo se arma la paleta a partir del wallpaper; cada wallpaper puede tener su excepción. No cambia los colores de estado.",
      "keywords": ["matugen", "paleta", "tema"], "apply": "next-use"
    },
    "appearance.contrast": {
      "type": "number", "default": 0, "min": 0, "max": 1, "presets": [[0, "Estándar"], [0.33, "Medio"], [0.66, "Alto"], [1, "Máximo"]],
      "category": "appearance", "section": "Color", "order": 30,
      "label": "Contraste",
      "description": "0 = estándar de Material; más contraste separa más textos y fondos (también los colores de estado).",
      "keywords": ["legibilidad", "tema"], "apply": "next-use"
    },
    "appearance.transparency": {
      "type": "enum", "default": "normal",
      "values": { "normal": "Normal", "reduced": "Reducida", "off": "Sin transparencia" },
      "category": "appearance", "section": "Superficies", "order": 40,
      "label": "Transparencia de los paneles",
      "description": "Nunca baja del mínimo legible sobre el wallpaper.",
      "keywords": ["opacidad", "blur", "translucidez"], "apply": "live"
    },
    "appearance.font.ui": {
      "type": "string", "kind": "font-sans", "default": "Plus Jakarta Sans", "maxLength": 120,
      "category": "appearance", "section": "Tipografía", "order": 60,
      "label": "Fuente de la interfaz",
      "description": "La de toda la shell, el bloqueo y la pantalla de inicio de sesión.",
      "keywords": ["letra", "tipografía", "font"], "apply": "live"
    },
    "appearance.font.mono": {
      "type": "string", "kind": "font-mono", "default": "Maple Mono NF", "maxLength": 120,
      "category": "appearance", "section": "Tipografía", "order": 70,
      "label": "Fuente de código",
      "description": "Rutas, comandos y valores técnicos.",
      "keywords": ["monoespaciada", "letra", "tipografía", "font"], "apply": "live"
    },
    "appearance.avatar": {
      "type": "enum", "default": "wallpaper",
      "values": { "wallpaper": "Del fondo", "image": "Imagen propia" },
      "category": "appearance", "section": "Avatar", "order": 80,
      "label": "Avatar",
      "description": "En el bloqueo, la pantalla de inicio de sesión y el arranque. Del fondo: se recorta del wallpaper en cada cambio de tema.",
      "keywords": ["foto", "perfil", "imagen", "face"], "apply": "live"
    },
    "appearance.avatarImage": {
      "type": "path", "kind": "image", "default": "~/Pictures/avatar.png",
      "category": "appearance", "section": "Avatar", "order": 90,
      "label": "Imagen del avatar",
      "description": "Se usa con «Imagen propia»; se recorta al centro.",
      "keywords": ["foto", "perfil"], "apply": "live"
    },
    "accessibility.textScale": {
      "type": "number", "default": 1, "min": 1, "max": 1.25,
      "presets": [[1, "Normal"], [1.12, "Grande"], [1.25, "Muy grande"]],
      "category": "accessibility", "section": "Texto", "order": 30,
      "label": "Tamaño del texto",
      "description": "Solo el texto: iconos y alturas no cambian.",
      "keywords": ["letra", "grande", "legibilidad", "baja visión", "zoom"], "apply": "live"
    },
    "accessibility.focusRing": {
      "type": "bool", "default": false,
      "category": "accessibility", "section": "Teclado", "order": 40,
      "label": "Foco siempre visible",
      "description": "Un anillo alrededor de lo que tiene el foco del teclado.",
      "keywords": ["teclado", "tab", "foco", "navegación"], "apply": "live"
    },
    "accessibility.highContrast": {
      "type": "bool", "default": false,
      "category": "accessibility", "section": "Color", "order": 20,
      "label": "Alto contraste",
      "description": "Textos secundarios y bordes con el contraste de los principales; paneles opacos.",
      "keywords": ["legibilidad", "contraste", "baja visión"], "apply": "live"
    },
    "accessibility.reduceMotion": {
      "type": "bool", "default": false,
      "category": "accessibility", "section": "Movimiento", "order": 10,
      "label": "Reducir movimiento",
      "description": "Sin animaciones ni transiciones en toda la shell ni en las ventanas.",
      "keywords": ["animaciones", "transiciones", "mareo"], "apply": "live",
      "hypr": "animations:enabled", "hyprInvert": true
    },
    "lock.glance.weather": {
      "type": "bool", "default": true,
      "category": "lock", "section": "De un vistazo", "order": 10,
      "label": "Clima",
      "description": "Temperatura y estado del cielo, sin la ubicación. No se muestra si los datos tienen más de 2 horas.",
      "keywords": ["bloqueo", "pantalla de bloqueo", "tiempo"], "apply": "next-use"
    },
    "lock.glance.media": {
      "type": "bool", "default": true,
      "category": "lock", "section": "De un vistazo", "order": 20,
      "label": "Música",
      "description": "Cuando algo suena: el título y el artista (o el reproductor); nunca la portada. Se ve aunque la sesión esté bloqueada.",
      "keywords": ["bloqueo", "reproductor", "canción"], "apply": "next-use"
    },
    "lock.glance.battery": {
      "type": "bool", "default": true,
      "category": "lock", "section": "De un vistazo", "order": 30,
      "label": "Batería",
      "description": "Solo cuando el equipo funciona con batería, con el color de aviso en los umbrales de batería baja.",
      "keywords": ["bloqueo", "carga", "energía"], "apply": "next-use"
    },
    "lock.glance.notifications": {
      "type": "bool", "default": true,
      "category": "lock", "section": "De un vistazo", "order": 40,
      "label": "Avisos",
      "description": "Cuántos avisos llegaron mientras estaba bloqueado, sin contenido. Con No molestar activo no se muestra.",
      "keywords": ["bloqueo", "notificaciones", "privacidad"], "apply": "next-use"
    },
    "bar.minWorkspaces": {
      "type": "int", "default": 5, "min": 1, "max": 10,
      "category": "bar", "section": "Escritorios", "order": 10,
      "label": "Escritorios que se muestran siempre",
      "description": "Cuántos escritorios aparecen en la barra aunque estén vacíos.",
      "keywords": ["workspaces"], "apply": "live"
    },
    "dashboard.weatherRefreshMinutes": {
      "type": "int", "default": 30, "min": 10, "max": 180, "step": 5, "unit": "min",
      "category": "dashboard", "section": "Hoy", "order": 10,
      "label": "Actualizar el clima cada",
      "description": "Cada consulta va a Open-Meteo; más tiempo, menos peticiones.",
      "keywords": ["clima", "tiempo", "open-meteo"], "apply": "live"
    },
    "capture.cardSeconds": {
      "type": "int", "default": 6, "min": 2, "max": 30, "unit": "s",
      "category": "capture", "section": "Vista previa", "order": 10,
      "label": "Duración de la tarjeta",
      "description": "Tiempo que la tarjeta de una captura queda en pantalla (se pausa con el puntero encima).",
      "apply": "live"
    },
    "capture.screenshotsDir": {
      "type": "path", "kind": "dir", "default": "~/Pictures/Screenshots",
