configuration {
    modi: "drun,window,run,filebrowser";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "  Apps";
    display-window: "  Ventanas";
    display-run: "  Ejecutar";
    display-filebrowser: "  Archivos";
    drun-display-format: "{icon} {name}";
    font: "Plus Jakarta Sans 11"; /* fuente de interfaz del design system (D1, P1.3) */
    sidebar-mode: false;
}

@theme "theme"
