/* Tema rofi a tono con waybar/hyprlock. */
/* Paleta generada por matugen (../../matugen/.config/matugen/templates/rofi.rasi) */
@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @text;
}

window {
    width: 38%;
    background-color: @mantle;
    border: 2px;
    border-color: @mauve;
    border-radius: 20px;
    padding: 18px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 14px;
}

inputbar {
    background-color: @surface0;
    border-radius: 999px;
    padding: 6px 14px 6px 6px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    background-color: @mauve;
    text-color: @base;
    border-radius: 999px;
    padding: 8px 12px;
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder: "Buscar...";
    placeholder-color: @subtext;
    vertical-align: 0.5;
}

listview {
    lines: 8;
    columns: 1;
    scrollbar: false;
    fixed-height: false;
    spacing: 4px;
}

element {
    padding: 8px 10px;
    border-radius: 12px;
    spacing: 10px;
}

element normal.normal {
    text-color: @text;
}

element selected.normal {
    background-color: @mauve;
    text-color: @base;
}

element-icon {
    size: 28px;
}

element-text {
    vertical-align: 0.5;
}
