/* Tema rofi a tono con quickshell/hyprlock. */
/* Paleta generada por matugen (../../matugen/.config/matugen/templates/rofi.rasi) */
@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @text;
}

window {
    width: 38%;
    background-color: @mantle;
    border: 2px;
    border-color: @mauve;
    border-radius: 24px; /* radius.xl (D4) */
    padding: 16px; /* space.lg: con radio 24 y entradas 8 quedan concentricas (Q1) */
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: @surface0;
    border-radius: 999px;
    padding: 4px 12px 4px 4px;
    children: [ prompt, entry ];
    spacing: 8px;
}

prompt {
    background-color: @mauve;
    text-color: @base;
    border-radius: 999px;
    padding: 8px 12px;
    font: "Plus Jakarta Sans SemiBold 11"; /* peso 600, escala D2 */
}

entry {
    placeholder: "Buscar...";
    placeholder-color: @subtext;
    vertical-align: 0.5;
}

listview {
    lines: 8;
    columns: 1;
    scrollbar: false;
    fixed-height: false;
    spacing: 4px;
}

element {
    padding: 8px 12px;
    border-radius: 8px; /* radius.sm: mismo rol que las filas de la barra (D4/Q2) */
    spacing: 12px; /* icono 28px <-> texto: space.md (S2) */
}

element normal.normal {
    text-color: @text;
}

element selected.normal {
    background-color: @mauve;
    text-color: @base;
}

element-icon {
    size: 28px;
}

element-text {
    vertical-align: 0.5;
    /* hereda el color del element: sin esto la fila seleccionada dejaba el
       texto claro sobre el fondo @mauve (KI-C19, P1.9/C5) */
    text-color: inherit;
}
