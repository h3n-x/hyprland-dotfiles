// Generado por matugen -- no editar a mano, editar templates/zellij-config.kdl
// zellij soporta `theme_dir` para cargar temas desde archivos sueltos (como
// el flavor.toml de yazi), pero esa directiva NO expande `~` ni `$HOME`
// (probado: falla con IoError si no es una ruta absoluta literal) -- como
// este repo tiene que servir para cualquier usuario/$HOME, no se puede
// hardcodear esa ruta. Por eso el theme va embebido directo en el config
// completo (mismo patron que starship.toml/satty.toml/cava.conf), y no hay
// paquete stow "zellij" -- este archivo ES ~/.config/zellij/config.kdl.
//
// Formato real de zellij 0.45 (verificado con `zellij setup --dump-config`):
// RGB decimal sin comas, no hex.
//
// Ojo: zellij corre un servidor por sesion -- una sesion ya abierta NO
// recoge un cambio de wallpaper hasta reiniciarla (`zellij kill-session
// <nombre>` o `zellij kill-all-sessions -y`); las sesiones nuevas si toman
// los colores actualizados.

themes {
    matugen {
        fg {{colors.on_surface.default.red}} {{colors.on_surface.default.green}} {{colors.on_surface.default.blue}}
        bg {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
        black {{colors.surface_variant.default.red}} {{colors.surface_variant.default.green}} {{colors.surface_variant.default.blue}}
        red {{status.error.default.red}} {{status.error.default.green}} {{status.error.default.blue}}
        green {{status.success.default.red}} {{status.success.default.green}} {{status.success.default.blue}}
        yellow {{status.warning.default.red}} {{status.warning.default.green}} {{status.warning.default.blue}}
        blue {{colors.secondary.default.red}} {{colors.secondary.default.green}} {{colors.secondary.default.blue}}
        magenta {{colors.primary.default.red}} {{colors.primary.default.green}} {{colors.primary.default.blue}}
        orange {{status.warning.default.red}} {{status.warning.default.green}} {{status.warning.default.blue}}
        cyan {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
        white {{colors.on_surface.default.red}} {{colors.on_surface.default.green}} {{colors.on_surface.default.blue}}
    }
}

theme "matugen"
