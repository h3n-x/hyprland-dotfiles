<!DOCTYPE fontscolors PUBLIC "-//NetBeans//DTD Editor Fonts and Colors settings 1.1//EN" "http://www.netbeans.org/dtds/EditorFontsColors-1_1.dtd">
<!-- Generado por matugen - no editar a mano, editar templates/netbeans-theme.bundle -->
<fontscolors>
    <fontcolor name="xml-attribute" default="markup-attribute"/>
    <fontcolor name="xml-cdata-section" default="default"/>
    <fontcolor name="xml-comment" default="comment"/>
    <fontcolor name="xml-doctype" default="default" foreColor="ff{{colors.primary.default.hex_stripped}}"/>
    <fontcolor name="xml-EOL" default="whitespace"/>
    <fontcolor name="xml-error" default="error"/>
    <fontcolor name="xml-operator" default="operator" foreColor="ff{{colors.on_surface_variant.default.hex_stripped}}"/>
    <fontcolor name="xml-pi-content" default="default" foreColor="ff{{colors.on_secondary_container.default.hex_stripped}}"/>
    <fontcolor name="xml-pi-end" default="default" foreColor="ff{{colors.primary.default.hex_stripped}}"/>
    <fontcolor name="xml-pi-start" default="default" foreColor="ff{{colors.primary.default.hex_stripped}}"/>
    <fontcolor name="xml-pi-target" default="default"/>
    <fontcolor name="xml-ref" default="entity-reference"/>
    <fontcolor name="xml-tag" default="markup-element"/>
    <fontcolor name="xml-text" default="default"/>
    <fontcolor name="xml-value" default="default" foreColor="ff{{status.success.default.hex_stripped}}"/>
    <fontcolor name="xml-ws" default="whitespace"/>
</fontscolors>
<!-- file: Editors/text/xml-external-parsed-entity/FontsColors/Matugen/org-netbeans-modules-editor-settings-CustomFontsColors-tokenColorings.xml -->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontscolors PUBLIC "-//NetBeans//DTD Editor Fonts and Colors settings 1.1//EN" "http://www.netbeans.org/dtds/EditorFontsColors-1_1.dtd">
<!-- Generado por matugen - no editar a mano, editar templates/netbeans-theme.bundle -->
<fontscolors>
    <fontcolor name="xml-attribute" default="markup-attribute"/>
    <fontcolor name="xml-cdata-section" default="default" foreColor="ff{{colors.on_secondary_container.default.hex_stripped}}"/>
    <fontcolor name="xml-comment" default="comment"/>
    <fontcolor name="xml-doctype" default="default" foreColor="ff{{colors.on_secondary_container.default.hex_stripped}}"/>
    <fontcolor name="xml-EOL" default="whitespace"/>
    <fontcolor name="xml-error" default="error"/>
    <fontcolor name="xml-operator" default="operator"/>
    <fontcolor name="xml-pi-content" default="default" foreColor="ff{{colors.on_secondary_container.default.hex_stripped}}"/>
    <fontcolor name="xml-pi-end" default="default" foreColor="ff{{colors.on_secondary_container.default.hex_stripped}}"/>
    <fontcolor name="xml-pi-start" default="default" foreColor="ff{{colors.on_secondary_container.default.hex_stripped}}"/>
    <fontcolor name="xml-pi-target" default="default" foreColor="ff{{colors.on_secondary_container.default.hex_stripped}}"/>
    <fontcolor name="xml-ref" default="entity-reference"/>
    <fontcolor name="xml-tag" default="markup-element"/>
    <fontcolor name="xml-text" default="default"/>
    <fontcolor name="xml-value" default="default" foreColor="ff{{status.success.default.hex_stripped}}"/>
    <fontcolor name="xml-ws" default="whitespace"/>
</fontscolors>
<!-- file: LookAndFeel/FlatLaf.properties -->
# Generado por matugen -- no editar a mano, editar templates/netbeans-theme.bundle
# Ventana de NetBeans (FlatLaf, Fase 17): bloque "matugen" de <userdir>/config/LookAndFeel/FlatLaf.properties
# (vale para FlatLaf Dark y Light; el LaF sigue al modo). Tus lineas debajo del bloque mandan.
# Lo demas de FlatLaf se deriva de estas variables. Estados fijos (P8.7) para error y aviso.
@background = #{{colors.surface_container_low.default.hex_stripped}}
@foreground = #{{colors.on_surface.default.hex_stripped}}
@disabledForeground = #{{colors.outline.default.hex_stripped}}
@componentBackground = #{{colors.surface_container.default.hex_stripped}}
@buttonBackground = #{{colors.surface_container_high.default.hex_stripped}}
@menuBackground = #{{colors.surface_container.default.hex_stripped}}
@accentColor = #{{colors.primary.default.hex_stripped}}
@selectionBackground = #{{colors.primary_container.default.hex_stripped}}
@selectionForeground = #{{colors.on_primary_container.default.hex_stripped}}
@selectionInactiveBackground = #{{colors.surface_container_highest.default.hex_stripped}}
@selectionInactiveForeground = #{{colors.on_surface.default.hex_stripped}}
@menuHoverBackground = #{{colors.surface_container_highest.default.hex_stripped}}

Component.borderColor = #{{colors.outline_variant.default.hex_stripped}}
Component.focusColor = #{{colors.primary.default.hex_stripped}}
Component.focusedBorderColor = #{{colors.primary.default.hex_stripped}}
Component.linkColor = #{{colors.primary.default.hex_stripped}}
Button.default.background = #{{colors.primary.default.hex_stripped}}
Button.default.foreground = #{{colors.on_primary.default.hex_stripped}}
ToolTip.background = #{{colors.surface_container_highest.default.hex_stripped}}
ToolTip.foreground = #{{colors.on_surface.default.hex_stripped}}

# Area del editor vacia y pestanas: el editor usa surface (perfil Matugen), alrededor un tono mas bajo.
Nb.EmptyEditorArea.background = #{{colors.surface_dim.default.hex_stripped}}
EditorTab.background = #{{colors.surface_container_low.default.hex_stripped}}
EditorTab.selectedBackground = #{{colors.surface.default.hex_stripped}}
EditorTab.underlineColor = #{{colors.primary.default.hex_stripped}}
ViewTab.underlineColor = #{{colors.primary.default.hex_stripped}}
TabbedPane.underlineColor = #{{colors.primary.default.hex_stripped}}
TabControlIcon.close.rolloverBackground = #{{status.error.default.hex_stripped}}
TabControlIcon.close.rolloverForeground = #{{status.on_error.default.hex_stripped}}
nb.html.link.foreground.visited = #{{colors.tertiary.default.hex_stripped}}

nb.errorForeground = #{{status.error.default.hex_stripped}}
nb.warningForeground = #{{status.warning.default.hex_stripped}}
nb.preferred.color.profile = Matugen
