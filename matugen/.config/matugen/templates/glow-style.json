{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "{{colors.on_surface.default.hex}}",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "{{colors.primary.default.hex}}",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{colors.on_primary_container.default.hex}}",
    "background_color": "{{colors.primary_container.default.hex}}",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "{{colors.secondary.default.hex}}",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "{{colors.outline.default.hex}}",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "{{colors.secondary.default.hex}}",
    "underline": true
  },
  "link_text": {
    "color": "{{colors.primary.default.hex}}",
    "bold": true
  },
  "image": {
    "color": "{{colors.tertiary.default.hex}}",
    "underline": true
  },
  "image_text": {
    "color": "{{colors.outline.default.hex}}",
    "format": "Image: \u007b\u007b.text\u007d\u007d →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{colors.tertiary.default.hex}}",
    "background_color": "{{colors.surface_container_high.default.hex}}"
  },
  "code_block": {
    "color": "{{colors.on_surface_variant.default.hex}}",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "{{colors.on_surface.default.hex}}"
      },
      "error": {
        "color": "{{status.on_error.default.hex}}",
        "background_color": "{{status.error.default.hex}}"
      },
      "comment": {
        "color": "{{code.comment.default.hex}}",
        "bold": {{code_style_flag.comment_bold}},
        "italic": {{code_style_flag.comment_italic}}
      },
      "comment_preproc": {
        "color": "{{code.annotation.default.hex}}"
      },
      "keyword": {
        "color": "{{code.keyword.default.hex}}",
        "bold": {{code_style_flag.keyword_bold}},
        "italic": {{code_style_flag.keyword_italic}}
      },
      "keyword_reserved": {
        "color": "{{code.keyword.default.hex}}",
        "bold": {{code_style_flag.keyword_bold}},
        "italic": {{code_style_flag.keyword_italic}}
      },
      "keyword_namespace": {
        "color": "{{code.keyword.default.hex}}",
        "bold": {{code_style_flag.keyword_bold}},
        "italic": {{code_style_flag.keyword_italic}}
      },
      "keyword_type": {
        "color": "{{code.type.default.hex}}",
        "bold": {{code_style_flag.type_bold}},
        "italic": {{code_style_flag.type_italic}}
      },
      "operator": {
        "color": "{{code.operator.default.hex}}"
      },
      "punctuation": {
        "color": "{{code.punctuation.default.hex}}"
      },
      "name": {
        "color": "{{code.variable.default.hex}}"
      },
      "name_builtin": {
        "color": "{{code.builtin.default.hex}}"
      },
      "name_tag": {
        "color": "{{code.tag.default.hex}}"
      },
      "name_attribute": {
        "color": "{{code.attribute.default.hex}}"
      },
      "name_class": {
        "color": "{{code.type.default.hex}}",
        "bold": {{code_style_flag.type_bold}},
        "italic": {{code_style_flag.type_italic}}
      },
      "name_constant": {
        "color": "{{code.constant.default.hex}}"
      },
      "name_decorator": {
        "color": "{{code.annotation.default.hex}}"
      },
      "name_exception": {
        "color": "{{code.type.default.hex}}"
      },
      "name_function": {
        "color": "{{code.function.default.hex}}"
      },
      "name_other": {},
      "literal": {
        "color": "{{code.constant.default.hex}}"
      },
      "literal_number": {
        "color": "{{code.number.default.hex}}"
      },
      "literal_date": {
        "color": "{{code.number.default.hex}}"
      },
      "literal_string": {
        "color": "{{code.string.default.hex}}"
      },
      "literal_string_escape": {
        "color": "{{code.escape.default.hex}}"
      },
      "generic_deleted": {
        "color": "{{status.error.default.hex}}"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "{{status.success.default.hex}}"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "{{colors.outline.default.hex}}"
      },
      "background": {
        "background_color": "{{colors.surface_container.default.hex}}"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
